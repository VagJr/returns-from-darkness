-int RenderQuadTexture( LPDIRECT3DDEVICE9 dev, LPDIRECT3DTEXTURE9 tex, LPDIRECT3DTEXTURE9 pal, LPDIRECT3DSURFACE9 vid, uchar* src )
-{
-	D3DLOCKED_RECT rect;
-	if( D3D_OK != tex->LockRect( 0, &rect, 0, 0 ) ) return 0;
-	// обновляем палитровую текстуру
