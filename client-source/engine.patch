+#pragma once
+// Isolate item generation/recreation from the deterministic combat random stream.
+struct RfdLootRandomScope {
+ int seed=RandomSeed,last=LastSeed;u64 seed64=RandomSeed64,last64=LastSeed64;uint count=RandUsingCounter,count64=Rand64UsingCounter;
+ ~RfdLootRandomScope(){if(RfdOnlineRequested()){RandomSeed=seed;LastSeed=last;RandomSeed64=seed64;LastSeed64=last64;RandUsingCounter=count;Rand64UsingCounter=count64;}}
+};
+struct RfdMonsterLootBatch {
+ bool online=RfdOnlineRequested();std::array<i64,MaxItems_255> before{};std::array<bool,MaxItems_255> existed{};RfdLootRandomScope random;
+ RfdMonsterLootBatch(){if(online)for(int i=0;i<ItemsCount;i++){int id=ItemActive[i];existed[id]=true;before[id]=Items[id].seed;}}
+ ~RfdMonsterLootBatch(){if(online)for(int i=0;i<ItemsCount;i++){int id=ItemActive[i];if(!existed[id]||before[id]!=Items[id].seed)NetSendCmdDItem(true,id);}}
+};
+int RfdPutGroundItem(int row,int col,const LastItemInfo &info);
