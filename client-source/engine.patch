+void __fastcall AddMonsterCorpse( int row, int col, int monsterSpriteNum, int orient )
+{
+	DeathMonstersMap[ row ][ col ] = (monsterSpriteNum & 0xff) + (orient << 8); // was uchar num and orient, causing dead array overflow
+}
