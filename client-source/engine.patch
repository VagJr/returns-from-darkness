+			4 * monster.intelligenceFactor + (GameMode == GM_HARD ? 50 : 35),
+				4 * monster.intelligenceFactor + (GameMode == GM_HARD ? 50 : 35),
+			4 * monster.intelligenceFactor + (GameMode == GM_HARD ? 50 : 35),
+				4 * monster.intelligenceFactor + (GameMode == GM_HARD ? 50 : 35),
+			4 * monster.intelligenceFactor + (GameMode == GM_HARD ? 50 : 35),
+				4 * monster.intelligenceFactor + (GameMode == GM_HARD ? 50 : 35),
+												4 * monster.intelligenceFactor + 55 ) ){
+			monster.Orientation = orientationToTarget;
