+  D3DLOCKED_RECT lock;if(SUCCEEDED(material->LockRect(0,&lock,nullptr,0))){HRESULT copied=converter->CopyPixels(nullptr,lock.Pitch,lock.Pitch*h,static_cast<BYTE*>(lock.pBits));material->UnlockRect(0);if(FAILED(copied)){material->Release();material=nullptr;}}
+ }
