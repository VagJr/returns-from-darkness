+  // Validate again after the GPU readback; a focus/position change must not
+  // leak another application's pixels into an on-disk artifact.
+  bool stable=currentOrigin.x==origin.x&&currentOrigin.y==origin.y&&current.right==width&&current.bottom==height;
+  FILE *file=stable&&qaOwnedClientVisible(bounds,reason)?fopen(menuQaCapture.c_str(),"wb"):nullptr;
+  if(file){BITMAPFILEHEADER header{};BITMAPINFOHEADER info{};header.bfType=0x4d42;header.bfOffBits=sizeof(header)+sizeof(info);header.bfSize=header.bfOffBits+width*height*4;info.biSize=sizeof(info);info.biWidth=width;info.biHeight=-height;info.biPlanes=1;info.biBitCount=32;info.biCompression=BI_RGB;fwrite(&header,sizeof(header),1,file);fwrite(&info,sizeof(info),1,file);for(int y=0;y<height;y++)fwrite((BYTE*)lock.pBits+(top+y)*lock.Pitch+left*4,4,width,file);fclose(file);qaCaptureEvidence("native-window-composition",width,height);menuQaCapture.clear();}
+  else qaCaptureState(stable?reason:"game-client-moved-during-readback",false);
+  copy->UnlockRect();
+ }else qaCaptureState("composition-readback-unavailable",false);copy->Release();
