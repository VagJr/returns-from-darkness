+				// 0043E68B
+				int newPlayerRow = player.Row + RowDelta[monster.Orientation];
+				int newPlayerCol = player.Col + ColDelta[monster.Orientation];
+				if( CellFreeForPlayer(playerIndex, newPlayerRow, newPlayerCol) ){
