+int __cdecl GetSelectedIpxGameButton()
+{
+	IpxWin *ipxWin; // eax@1
+	IpxGame *nextGame; // ecx@3
+	IpxGame *ipxGame; // edx@5
+
+	ipxWin = (IpxWin *) GetFocus();
