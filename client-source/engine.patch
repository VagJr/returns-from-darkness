+bool CursorOnManaGlobe() {
+	int centerX = ScreenWidth / 2 + 182;
+	int centerY = ScreenHeight - 100;
+	return (abs(centerX - CursorX)*abs(centerX - CursorX) + abs(centerY - CursorY)*abs(centerY - CursorY)) < 1600;
+}
+
+bool CursorOnHealthGlobe() {
+	int centerX = ScreenWidth / 2 - 182;
+	int centerY = ScreenHeight - 100;
+	return (abs(centerX - CursorX)*abs(centerX - CursorX) + abs(centerY - CursorY)*abs(centerY - CursorY)) < 1600;
+}
