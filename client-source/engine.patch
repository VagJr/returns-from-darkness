+//----- (007182D0) --------------------------------------------------------
+void UpdateAllItems()
+{
+	Player& player = Players[CurrentPlayerIndex];
+	int itemCount = player.InvItemCount + IS_10_7_Inventory;
+	for( int i = 0; i < itemCount; ++i ){
+		UpdateItem( player.OnBodySlots[i] );
+	}
+}
