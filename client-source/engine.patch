+bool SizeMaximized = false;
+bool IsSizingWindow = false;
+bool D3dReset();
+
+//----- (th2) -------------------------------------------------------------
+void CursorOn()
+{
+	CURSORINFO ci = { 0 };
+	ci.cbSize = sizeof( ci );
+	GetCursorInfo( &ci );
+	if( ci.flags == 0 ){
+		while( ShowCursor( 1 ) <= 0 );
+	}
+}
+
+//----- (th2) -------------------------------------------------------------
+void CursorOff()
+{
+	CURSORINFO ci = { 0 };
+	ci.cbSize = sizeof( ci );
+	GetCursorInfo( &ci );
+	if( ci.flags == CURSOR_SHOWING ){
+		while( ShowCursor( 0 ) > 0 );
+	}
+}
