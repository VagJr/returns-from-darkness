-void add_frame(GIF *gif, ushort delay)
-{
-    ushort w, h, x, y;
-    uchar* tmp;
-
-    if( delay )
-        set_delay(gif, delay);
-    if( gif->nframes == 0 ){
-        w = gif->w;
-        h = gif->h;
-        x = y = 0;
-    }else if( !get_bbox(gif, &w, &h, &x, &y) ){
-        /* image's not changed; save one pixel just to add delay */
-        w = h = 1;
-        x = y = 0;
-    }
-    put_image(gif, w, h, x, y);
-    gif->nframes++;
-    tmp = gif->back;
-    gif->back = gif->frame;
-    gif->frame = tmp;
-}
