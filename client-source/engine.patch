+ if((player.gameChanger&(BIT(GC_14_CLEAN_HANDS)|BIT(GC_9_NIGHT_KIN)))||HasTrait(CurrentPlayerIndex,TraitId::Barbarian))return;
+ int unique=-1;
+ if(bossId==UM_1_Skeleton_King)unique=4618;
+ else if(bossId==UM_9_The_Butcher)unique=4619;
+ else if(baseMonsterId==BM_110_DIABLO)unique=4620;
+ if(unique<0)return;
+ // Additional rewards must not advance the legacy loot/combat random stream.
+ struct RandomRestore {int seed=RandomSeed,last=LastSeed;u64 seed64=RandomSeed64,last64=LastSeed64;uint count=RandUsingCounter,count64=Rand64UsingCounter;
+  ~RandomRestore(){RandomSeed=seed;LastSeed=last;RandomSeed64=seed64;LastSeed64=last64;RandUsingCounter=count;Rand64UsingCounter=count64;}} restore;
+ LARGE_INTEGER clock;QueryPerformanceCounter(&clock);
+ SetRndSeed(int(u64(clock.QuadPart)^u64(unique)*0x9e3779b97f4a7c15ULL));
+ SpawnUnique(unique,row,col,sendMsg);
+}
