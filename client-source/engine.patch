+		if( MayMoveMonsterToDirection(monsterIndex, orientation) ){
+			StartMonsterWalk(monsterIndex, orientation);
+			return 1;
+		}
+		orientation = OrientMinusOne[orientation];
+	}
+
+	if( !MayMoveMonsterToDirection(monsterIndex, orientation) ){
