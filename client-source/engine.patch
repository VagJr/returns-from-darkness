+            break;
+        case WM_SYSKEYDOWN:
+        case WM_SYSKEYUP:
+            SendMessageA( SDrawGetFrameWindow( 0 ), Msg, wParam, lParam );
+            break;
+        case WM_COMMAND:
+            if( (ushort)wParam == 2 )
