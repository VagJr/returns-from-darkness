+							for( int i = 0; i < len; ++i, ++srcX ){ if( bool t = srcX % 2; srcY % 2 ? t : !t ) dst[i] = pal[(uchar)cel[i]]; }
+						}else{
+							for( int i = 0; i < len; ++i ) dst[i] = pal[(uchar)cel[i]];
