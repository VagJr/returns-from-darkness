-		data = DeltaParseObjects( data, netLevelData.objects );
-        data = DeltaParseMonsters( data, netLevelData.monsters );
-        data = DeltaParseSummons( data, netLevelData.summons );
-    }
-    else{
-        TerminateWithError( "msg:1" );
-    }
-	++sgbDeltaChunks;
-	sgbDeltaChanged = true;
