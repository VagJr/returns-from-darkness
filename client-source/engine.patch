+void CaptureWindowMenuQaFrame(){
+ if(menuQaCapture.empty()||!D3dDevice||!ghMainWnd)return;
+ RECT client{};POINT origin{};GetClientRect(ghMainWnd,&client);ClientToScreen(ghMainWnd,&origin);
+ RECT bounds{origin.x,origin.y,origin.x+client.right,origin.y+client.bottom};const char *reason="";
+ if(!qaOwnedClientVisible(bounds,reason)){qaCaptureState(reason,false);return;}
+ D3DDISPLAYMODE mode{};IDirect3DSurface9 *copy=nullptr;D3DLOCKED_RECT lock{};
+ if(FAILED(D3dDevice->GetDisplayMode(0,&mode))){qaCaptureState("display-mode-unavailable",false);return;}
+ // The default D3D adapter's front buffer is on the primary display. Reject
+ // off-display/partly clipped clients instead of capturing a desktop fragment.
+ int left=origin.x,top=origin.y,width=client.right,height=client.bottom;
+ if(left<0||top<0||width<=0||height<=0||left+width>int(mode.Width)||top+height>int(mode.Height)){qaCaptureState("game-client-outside-adapter",false);return;}
+ if(FAILED(D3dDevice->CreateOffscreenPlainSurface(mode.Width,mode.Height,D3DFMT_A8R8G8B8,D3DPOOL_SYSTEMMEM,&copy,nullptr))){qaCaptureState("composition-copy-unavailable",false);return;}
+ if(SUCCEEDED(D3dDevice->GetFrontBufferData(0,copy))&&SUCCEEDED(copy->LockRect(&lock,nullptr,D3DLOCK_READONLY))){
