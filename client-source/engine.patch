+  if(written){std::string backup=projectSaveTarget+".bak";written=GetFileAttributesA(projectSaveTarget.c_str())==INVALID_FILE_ATTRIBUTES?MoveFileExA(projectPendingSave.c_str(),projectSaveTarget.c_str(),MOVEFILE_WRITE_THROUGH)!=FALSE:ReplaceFileA(projectSaveTarget.c_str(),projectPendingSave.c_str(),backup.c_str(),0,nullptr,nullptr)!=FALSE;}
+  projectPendingSave.clear();if(!written){AddWorldMessage("Character checkpoint failed. Previous save preserved.");return;}
