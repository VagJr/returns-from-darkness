+		}
+	}
+
+	if( player.currentAnimationFrame >= player.AttackAnimationFrameCount ){
+		StartStand(playerIndex, player.dir);
+		ClearPlrPVars(playerIndex);
+		return true;
+	}
+	return false;
+}
