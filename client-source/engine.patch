+//----- (0042BA92) --------------------------------------------------------
+bool CheckGetRecord( const LastItemInfo& info )
+{
+	i64 dwCurr = GetTickCountTh();
+	for( int i = 0; i < ItemGetCount; i++ ){
+		if( (dwCurr - ItemGets[i].timeStamp) > RESEND_TIME ) {
+			DeleteGetRecord( i );
+			i--;
+			continue;
+		}
+		if( info == ItemGets[i] ){
+			return FALSE;
+		}
+	}
+	return TRUE;
+}
