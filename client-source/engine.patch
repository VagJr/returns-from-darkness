+//----- (0042A82A) --------------------------------------------------------
+int __fastcall GetRandomBaseForAdriaItems(int maxQlvl)
+{
+	vla( int, goodItems, GOOD_ITEM_COUNT );
+	int goodItemsCount = 0;
+
+	for( uint baseItemIndex = 1; baseItemIndex < count_BaseItems; baseItemIndex++ ){
