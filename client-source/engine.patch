+void __fastcall KillDiabloEffect(int monsterIndex, int a1)
+{
+	int v2; // esi@1
+	int v3; // edi@1
+	int v4; // ebx@5
+	int v5; // esi@7
+	int v6; // esi@9
+	int v7; // eax@10
