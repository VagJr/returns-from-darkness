+
+	//goto elix; // проверял выпадание эликсиров
+	if( specialDrop & 0x8000 ){
+		return -1 - (specialDrop & 0xFFF);// дроп уника
+	}
+	if( specialDrop & 0x4000 || RNG(100) > 40 ){
+		return 0;// нет дропа
+	}
+	if( RNG(100) > 25 ){
+		// шанс выпадения золота дополнительно уменьшается в 3 раза
