+//----- (0041A3B3) -------------------------------------------------------- interface
+void __fastcall DrawMovingSpriteLight(int x, int y, int curAnim, int curFrameIndex, int pitch, int shiftY, int tileInCellIndex, char uniqTrans)
+{
+	if(WorkingSurface && y-16*shiftY>=0 && y-16*shiftY<WorkingHeight)RfdHdClearSprite(WorkingSurface+x+YOffsetHashTable[y-16*shiftY],pitch,160);
+	int v8;  // edi@2
+	int v9;  // ebx@4
+	int v10; // esi@4
+	int v11; // eax@6
+	int v12; // eax@10
+	int v13; // edi@10
+	int v14; // esi@10
+	int v15; // eax@4
+	int v16; // eax@10
+	int v17; // [sp+Ch] [bp-4h]@1
+	v17 = x;
+	if( WorkingSurface ){
+		v8 = curAnim;
+		if( curAnim ){
+			if( curFrameIndex > 0 ){
+				v9 = *(uint*)(curAnim + 4 * curFrameIndex);
+				v10 = curAnim + v9;
+				v15 = *(ushort*)(curAnim + v9 + shiftY);
+				curAnim = *(ushort*)(curAnim + v9 + shiftY);
+				if( v15 ){
+					if( tileInCellIndex == 8 ){
+						v11 = 0;
+					}else{
+						v11 = *(ushort*)(v10 + tileInCellIndex);
+					}
+					if( !v11 ){
+						v11 = *(uint*)(v8 + 4 * curFrameIndex + 4) - v9;
+					}
+					v14 = curAnim + v10;
+					v13 = v11 - curAnim;
+					v16 = -(Light4Levels != 0);
+					LOWORD_IDA(v16) = v16 & 0xF400;
+					v12 = v16 + 4096;
+					if( uniqTrans == 2 ){
+						v12 += 256;
+					}
+					if( uniqTrans >= 4 ){
+						v12 = v12 + (uniqTrans << 8) - 256;
+					}
+					DrawSpritePal(&WorkingSurface[v17] + YOffsetHashTable[y - 16 * shiftY], (char*)v14, v13, pitch, &LightTable[v12]);
+				}
+			}
+		}
+	}
+}
