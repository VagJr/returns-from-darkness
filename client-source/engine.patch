+		strcpy(cow.Name, "Cow");
+
+		int someRow = cowRow + CowsDeltaRow[CowsOrients[cowIndex]];
+		int someCol = cowCol + CowsDeltaCol[CowsOrients[cowIndex]];
+
+		if( !MonsterMap[ cowRow ][ someCol ] ){
+			MonsterMap[ cowRow ][ someCol ] = -1 - TownersCount;
