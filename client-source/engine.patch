-	}
-	uchar* pixel = src + left + top * width;
-	T* pixel32 = (T*) dst + left + top * dstPitch / sizeof( T );
-	int srcDelta = srcPitch - width;
-	for( int y = 0; y < height; ++y ){
-		for( int x = 0; x < width; ++x ){
-			*pixel32++ = pal[ *pixel++ ];
-		}
-		pixel += srcDelta;
-		*(char**)&pixel32 += dstPitch - width * sizeof(T);
-	}
