+struct StatEffects
+{
+	short adds[ST_count];
+	short percent[ST_count];
+	void operator+=(StatEffects& a){ for(int i = 0; i < ST_count; ++i){ adds[i] += a.adds[i]; percent[i] += a.percent[i]; } }
+	void operator-=(StatEffects& a){ for(int i = 0; i < ST_count; ++i){ adds[i] -= a.adds[i]; percent[i] -= a.percent[i]; } }
+};
