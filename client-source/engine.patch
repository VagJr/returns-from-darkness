+//----- (0044765B) --------------------------------------------------------
+int ParseCmdBounded( int playerIndex, const TCmd* packet, int bytes )
+{
+    if( !packet || bytes < sizeof(TCmd) || playerIndex < 0 || playerIndex >= PlayersMax_4 ) return 0;
+    uchar cmd = packet->bCmd;
+    bool delta = cmd == CMD_83_DLEVEL_JUNK || cmd == CMD_84_DLEVEL_END
+        || ((cmd & CMD_DLEVEL) && (cmd & ~CMD_DLEVEL) < DungeonCount);
+    if( delta || cmd == CMD_2_ACK_PLRINFO || cmd == CMD_54_SEND_PLRINFO ){
+        if( bytes < sizeof(TCmdPlrInfoHdr) ) return 0;
+        const auto* chunk = (const TCmdPlrInfoHdr*)packet;
+        size_t capacity = delta ? sizeof(sgbRecvLevel) : sizeof(LastPlayerInfo);
+        if( !chunk->wBytes || chunk->wBytes > bytes - sizeof(*chunk)
+         || chunk->wOffset > capacity || chunk->wBytes > capacity - chunk->wOffset ) return 0;
+    }else if( cmd == CMD_86_STRING ){
+        if( bytes < 2 || !memchr((const uchar*)packet + 1, 0,
+            std::min<size_t>(bytes - 1, sizeof(((TCmdString*)nullptr)->str))) ) return 0;
+    }else if( cmd == CMD_35_SYNCDATA ){
+        // The packed sync header has two item records; wLen follows the 3-byte prefix.
+        const size_t headerBytes = 14 + 2 * sizeof(LastItemInfo);
+        if( bytes < headerBytes ) return 0;
+        ushort payloadBytes;
+        memcpy(&payloadBytes, (const uchar*)packet + 3, sizeof(payloadBytes));
+        if( payloadBytes > bytes - headerBytes || payloadBytes % sizeof(TSyncMonster)
+         || ((const uchar*)packet)[1] >= DungeonCount ) return 0;
+    }
+    return ParseCmd(playerIndex, packet);
+}
