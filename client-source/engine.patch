+		// 0043E5FF
+		if( player.CurLife > player.MaxCurLife ){ // here was the bug with the curLife checking in case of Players[0].CurLife negative value
+			player.CurLife = player.MaxCurLife;
+			player.BaseLife = player.MaxBaseLife;
