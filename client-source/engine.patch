+//----- (0041A2F7) -------------------------------------------------------- interface
+void __fastcall DrawMonsterFramePixel_2(int a1, int a2, int a3, int a4, char a5)
+{
+	int result; // eax@1
+	char v6;    // dl@1
+	int v7;     // ecx@1
+	int v8;     // ebx@1
+	int v9;     // edi@1
+	int v10;    // esi@1
+	int v11;    // edx@15
+	char v12;   // dh@4
+	char v13;   // dh@9
