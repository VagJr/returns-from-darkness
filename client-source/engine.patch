+__forceinline void EncodePixel( unsigned char countSamePixel, unsigned char pixel, unsigned char*&destBuffer, int& bytesToWrite )
+{
+    if( countSamePixel > 1 || pixel >= 0b11000000 ){
+        *destBuffer++ = countSamePixel | 0b11000000;
+        ++bytesToWrite;
+    }
+    *destBuffer++ = pixel;
+    ++bytesToWrite;
+}
