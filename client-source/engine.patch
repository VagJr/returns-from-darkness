+{
+	return genVersion == item.genVersion
+		&& dropType == item.dropType
+		&& seed == item.seed
+		&& quality == item.quality
+		&& magicFind == item.magicFindSeed
+		&& baseItemIndex == item.baseItemIndex
+		&& uniqIndex == item.uniqIndexSeed;
+}
