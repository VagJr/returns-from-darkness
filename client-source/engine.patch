+#include "stdafx.h"
+#include "CommunityProgress.h"
+#include "CommunityHub.h"
+
+GAME_MODE GameMode = GM_NORMAL;
+
+int RfdRoomCharacterMode()
+{
+    char roomMode[32] = {};
+    GetEnvironmentVariableA("RFD_ROOM_MODE", roomMode, sizeof(roomMode));
+    return strcmp(roomMode, "coliseum-pvp") == 0 ? GM_COLISEUM : GM_NORMAL;
+}
+
+bool RfdCharacterRulesMatchRoom(int mode, bool explain)
+{
+    if (!RfdOnlineRequested() || mode == RfdRoomCharacterMode()) return true;
+    if (explain) RfdShowNotice("Santuario - Personagem",
+        RfdRoomCharacterMode() == GM_COLISEUM
+        ? "Esta sala usa personagens do Coliseum. Escolha ou crie um personagem de arena. Seu personagem de campanha foi preservado."
+        : "Esta sala usa as regras Normal de campanha cooperativa. Escolha ou crie um personagem Normal. Seu personagem com regras especiais foi preservado.");
+    return false;
+}
+
+bool RfdCharacterRulesQa()
+{
+#if RFD_DEV_QA
+    char test[16] = {}, profile[MAX_PATH] = {};
+    GetEnvironmentVariableA("RFD_ENGINE_QA", test, sizeof(test));
+    GetEnvironmentVariableA("RFD_PROFILE", profile, sizeof(profile));
+    if ((strcmp(test, "options") && strcmp(test, "render")) || !strstr(profile, "engine-qa-")) return false;
+    char oldTicket[64] = {}, oldMode[32] = {};
+    GetEnvironmentVariableA("RFD_ROOM_TICKET", oldTicket, sizeof(oldTicket));
+    GetEnvironmentVariableA("RFD_ROOM_MODE", oldMode, sizeof(oldMode));
+    bool solo = true, campaign = true, arena = true, savedLevel = true;
+    SetEnvironmentVariableA("RFD_ROOM_TICKET", nullptr);
+    for (int mode = 0; mode < 9; ++mode) solo &= RfdCharacterRulesMatchRoom(mode);
+    SetEnvironmentVariableA("RFD_ROOM_TICKET", "isolated-options-fixture");
+    SetEnvironmentVariableA("RFD_ROOM_MODE", "campaign-coop");
+    for (int mode = 0; mode < 9; ++mode) campaign &= RfdCharacterRulesMatchRoom(mode) == (mode == GM_NORMAL);
+    // Exercise the real native serializer/parser used between save loading and the join call.
+    for (int level : {1, 20, 35, 83}) {
+        CharSaveInfo source = {}, selected = {};char description[256] = {};
+        source.Class = PC_0_WARRIOR;source.GameMode = GM_NORMAL;source.Level = level;
+        source.Stats.Strength = source.Stats.Magic = source.Stats.Dexterity = source.Stats.Vitality = 25;
+        savedLevel &= UiCreatePlayerDescription(&source, SaveSignature, description) && GetCharSaveInfo(description, &selected) && selected.Level == level;
+        savedLevel &= RfdProgressHeroDifficultyAllowed(1, int(selected.Level), false) == (level >= 20);
+        savedLevel &= RfdProgressHeroDifficultyAllowed(2, int(selected.Level), false) == (level >= 35);
+        savedLevel &= RfdProgressHeroDifficultyAllowed(8, int(selected.Level), false) == (level >= 83);
+    }
+    SetEnvironmentVariableA("RFD_ROOM_MODE", "coliseum-pvp");
+    for (int mode = 0; mode < 9; ++mode) arena &= RfdCharacterRulesMatchRoom(mode) == (mode == GM_COLISEUM);
+    SetEnvironmentVariableA("RFD_ROOM_TICKET", oldTicket[0] ? oldTicket : nullptr);
+    SetEnvironmentVariableA("RFD_ROOM_MODE", oldMode[0] ? oldMode : nullptr);
+    FILE* report = fopen((std::string(profile) + "\\character-rules-qa.json").c_str(), "w");
+    if (report) {
+        fprintf(report, "{\"passed\":%s,\"soloRulesPreserved\":%s,\"cooperativeNormalOnly\":%s,\"arenaCharactersOnly\":%s,\"selectedHeroLevelFromNativeSaveDescription\":%s,\"heroDifficultyMinimumsEnforced\":%s}",
+            solo && campaign && arena && savedLevel ? "true" : "false", solo ? "true" : "false", campaign ? "true" : "false", arena ? "true" : "false", savedLevel ? "true" : "false", savedLevel ? "true" : "false");
+        fclose(report);
+    }
+    return strcmp(test, "options") == 0;
+#else
+    return false;
+#endif
+}
