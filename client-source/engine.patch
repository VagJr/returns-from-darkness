+		int spell = baseItem.SpellNumber;
+		if( goodItemsCount < GOOD_ITEM_COUNT ){
+            if( MaxCountOfPlayersInGame == 1 && (spell == PS_32_BONE_SPIRIT_REAL_RESSURECT || spell == PS_34_HEAL_OTHER) ){
