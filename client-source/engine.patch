+PlayerStat GetStartStat( PLAYER_FULL_CLASS fullClassId, TraitId trait1, TraitId trait2, int playerIndex )
+{
+    PlayerStat result = FullPlayerClasses[fullClassId].StartStat;
+	const Player& player = Players[playerIndex];
+
+	if (is(TraitId::Paladin,	trait1, trait2))		{ result.Strength	=  20; result.Magic = 15; result.Dexterity = 10; result.Vitality = 20; }
+	if (is(	TraitId::Mamluk,	trait1, trait2))		{ result.Strength	=  20; result.Magic = 5; result.Dexterity = 20; result.Vitality = 20; }
+	if (is (TraitId::Pistoleer, trait1, trait2))		{ result.Strength	=  20; result.Magic = 0; result.Dexterity = 20; result.Vitality = 25; }
+	if( is( TraitId::Gifted,	trait1, trait2 ) )      { result            +=  5; } // +5 to starting stats
+	if( is( TraitId::BlueBlood, trait1, trait2) )		{ result			+= 10; } // +10 to starting stats 
+	if( is( TraitId::Rudiarius, trait1, trait2 ) )      { result.Vitality   -=  5; } // start game with -5 to base Vitality
+	if (is( TraitId::LitheBuild, trait1, trait2))		{ result.Dexterity	+=  5; } // start game with +5 to base Dexterity
+	if (player.gameChanger & BIT(GC_23_TOUGH_LUCK)) {
+		result.Strength = 5;
+		result.Magic = 5;
+		result.Dexterity = 5;
+		result.Vitality = 5;
+	}
+
+    return result;
+};
+
+PlayerStat GetMaxStat( PLAYER_FULL_CLASS fullClassId, TraitId trait1, TraitId trait2, int playerIndex)
+{
+    PlayerStat result = FullPlayerClasses[fullClassId].MaxStat;
+	const Player& player = Players[playerIndex];
+
+	if( is( TraitId::Mamluk, trait1, trait2))			{	 result.Strength	=  475; result.Magic = 150;	result.Dexterity = 475; result.Vitality = 400; }
+	if (is( TraitId::Pistoleer, trait1, trait2))		{	 result.Strength	=  600;	result.Magic =  50;	result.Dexterity = 400; result.Vitality = 450; }
+	if (is( TraitId::Black_Witchery, trait1, trait2))	{	 result.Strength	=  300; result.Magic = 400; result.Dexterity = 500; result.Vitality	= 300; }
+	if( is( TraitId::BendTheRules, trait1, trait2))		{	 result.Strength	=  900; result.Magic = 900;	result.Dexterity = 900; result.Vitality = 900; } // all max stats = 900
+	if( is( TraitId::Gifted, trait1, trait2 ) )         {    result             +=  25; } // +25 to maximum stats
+	if( is( TraitId::OldFashioned, trait1, trait2 ) )   {    result.Dexterity   +=  40; } // +(CLVL*3) to AC, +(CLVL*2) to damage, +40 to maximum base Dexterity
+	if (is( TraitId::LitheBuild, trait1, trait2))		{	 result.Dexterity	+= 100; }
+	if( is( TraitId::Bruiser, trait1, trait2 ) )        {    result.Strength    += 150;
+                                                             result.Dexterity   -= 150; } // +150 maximum base Strength, -150 maximum base Dexterity
+    if( is( TraitId::Negotiant, trait1, trait2 ) )      {    result.Vitality    -=  50; } // -50 maximum base Vitality
+	if( is( TraitId::Paladin, trait1, trait2))			{	 result.Magic		+=  200 
+																				+ PerkValue(SYNERGY_THAUMATURGY, playerIndex);  } // +70 maximum base Magic + value from Thaumaturgy synergy
+	if( is( TraitId::Leper, trait1, trait2 ) )          {    result.Dexterity   +=  75;
+                                                             result.Magic       +=  75; } // +75 maximum base Dexterity, +75 maximum base Magic
+	if (is( TraitId::Ranger, trait1, trait2))			{	 result.Vitality	-=  40;
+															 result.Magic		+=  40;	} 
+	if( player.gameChanger& BIT(GC_9_NIGHT_KIN))		{	 result.Magic		+= 225;
+															 result.Dexterity	+= 125;
+															 result.Strength	-= 200; }
+	if (PerkValue(SYNERGY_OSTENTATION, playerIndex) > 0) {
+															 result.Strength	+= PerkValue(SYNERGY_OSTENTATION, playerIndex);
+															 result.Magic		+= PerkValue(SYNERGY_OSTENTATION, playerIndex);
+															 result.Dexterity	+= PerkValue(SYNERGY_OSTENTATION, playerIndex);
+															 result.Vitality	+= PerkValue(SYNERGY_OSTENTATION, playerIndex);
+	}
+
+    return result;
+};
+
+PlayerStat GetPlayerMaxStat( int playerIndex )
+{
+    const Player& player = Players[playerIndex];
+    return GetMaxStat( player.fullClassId, player.traits[0], player.traits[1], playerIndex );
