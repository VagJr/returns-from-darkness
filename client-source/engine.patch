+void ClearScreen()
+{
+	int v0;   // edx@1
+	void* v1; // edi@1
+	LockSrcSurface();
+	v1 = WorkingSurface + WorkingWidth * Screen_TopBorder + Screen_LeftBorder;
+	v0 = ScreenHeight;
+	do{
+		memset(v1, 0, ScreenWidth);
+		v1 = (char*)v1 + WorkingWidth;
+		--v0;
+	}while( v0 );
+	UnlockSrcSurface();
+}
