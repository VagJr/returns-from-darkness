+bool UseFullHealingPotion(int playerIndex)
+{
+	Player& player = Players[playerIndex];
+	if( player.CurLife != player.MaxCurLife ){
+        player.CurLife = player.MaxCurLife;
+        player.BaseLife = player.MaxBaseLife;
+        return true;
+    }else{
+        return false;
+    }
+}
