+//----- (00717750) --------------------------------------------------------
+void __fastcall AddBossTypeToQuestLoc( int uniqueMonsterIndex )
+{
+	AddMonsterTypeToDungeon( UniqueMonsters[ uniqueMonsterIndex ].BaseMonsterIndex, MPF_4_UNIQ );
+	CreateBoss( uniqueMonsterIndex, 0, 0 );
+}
