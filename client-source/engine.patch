+//----- (0041A51F) -------------------------------------------------------- interface
+void __fastcall DrawMovingSprite(int x, int y, int curAnim, int curFrameIndex, int pitch, int shiftY, int tileInCellIndex, bool darken /*= false*/ )
+{
+	if( WorkingSurface && curAnim && curFrameIndex > 0 ){
+		uint* curFrame = (uint*)curAnim + curFrameIndex;
+		int frameOfs = *curFrame;
+		int frameBegin = *(ushort*)(curAnim + frameOfs + shiftY);
+		if( frameBegin ){
+			int frameEnd = tileInCellIndex == 8 ? 0 : *(ushort*)(curAnim + frameOfs + tileInCellIndex);
+			if( frameEnd == 0 ){
+				frameEnd = *(curFrame + 1) - frameOfs;
+			}
+			int size = frameEnd - frameBegin;
+			char* src = (char*)frameBegin + curAnim + frameOfs;
+			uchar* dst = &WorkingSurface[x] + YOffsetHashTable[y - 16 * shiftY];
+			if( darken && DarkLevel ){
+				DrawSpritePal(dst, src, size, pitch, &LightTable[256 * DarkLevel]);
+			}else{
+				DrawSpriteCL2((int)dst, (int)src, size, pitch);
+			}
+		}
+	}
