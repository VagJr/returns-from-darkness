+//----- (004484C5) --------------------------------------------------------
+uint On_REQUESTAGITEM( const TCmdGItem* packet, int playerIndex )
+{
+	if( NetItem ){
+		auto src = (TCmdGItem*)packet;
+		Player& player = Players[playerIndex];
+
+		if( gbBufferMsgs == BUFFER_ON 
+		 || !i_own_level(player.dungeon)
