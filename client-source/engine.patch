+ if(!palette||paletteBytes<768){if(palette)FreeMem(palette);return false;}
+ std::vector<unsigned char> icon(width*height,0);
+ for(int p=0;p<width*height;p++)if(rgba[p*4+3]>=64){
+  int best=0x7fffffff;unsigned char color=32;
+  for(int i=32;i<256;i++){
+   int r=int(rgba[p*4+2])-palette[i*3],g=int(rgba[p*4+1])-palette[i*3+1],b=int(rgba[p*4])-palette[i*3+2];
+   int distance=r*r*2+g*g*3+b*b;if(distance<best){best=distance;color=static_cast<unsigned char>(i);}
+  }
