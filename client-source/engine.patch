-	Player* v1; // edi@1
-	void* v3; // ebx@1
-	Player* v4; // ebp@1
-	Player* result; // eax@4
-
-	v1 = memory;
-	v3 = malloc( rand() & 0x7FFF );
-	v4 = (Player*) malloc( sizeof(Player) * (PlayersMax_4 + 1) ); // 5-th player struct reserved for special save operations
-	if( v3 ){
-		free( v3 );
