+std::vector<unsigned char> rfdRelicCel(const std::vector<std::vector<unsigned char>> &frames,int width,int height){
+ std::vector<unsigned char> result((frames.size()+2)*sizeof(unsigned int),0);
+ reinterpret_cast<unsigned int*>(result.data())[0]=unsigned(frames.size());
+ for(size_t frame=0;frame<frames.size();frame++){
+  reinterpret_cast<unsigned int*>(result.data())[frame+1]=unsigned(result.size());
+  // CEL uses a ten-byte clipping header followed by bottom-to-top RLE rows.
+  result.push_back(10);result.push_back(0);for(int i=0;i<8;i++)result.push_back(0);
+  for(int y=height-1;y>=0;y--)for(int x=0;x<width;){
+   const bool solid=frames[frame][y*width+x]!=0;int n=1;
+   while(x+n<width&&n<127&&(frames[frame][y*width+x+n]!=0)==solid)n++;
+   result.push_back(solid?static_cast<unsigned char>(n):static_cast<unsigned char>(256-n));
+   if(solid)result.insert(result.end(),frames[frame].begin()+y*width+x,frames[frame].begin()+y*width+x+n);
+   x+=n;
+  }
+ }
+ reinterpret_cast<unsigned int*>(result.data())[frames.size()+1]=unsigned(result.size());return result;
+}
+bool rfdRelicLoad(int index){
+ if(index<0||index>=RfdRelicCount)return false;
+ if(RfdRelicAttempted[index])return !RfdRelicIcons[index].empty();RfdRelicAttempted[index]=true;
+ wchar_t path[MAX_PATH];GetModuleFileNameW(nullptr,path,MAX_PATH);wchar_t *tail=wcsrchr(path,L'\\');if(!tail)return false;
