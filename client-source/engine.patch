+void CloseOldWinExplorer()
+{
+	HWND momParent = FindingOldWinExplorer();
+	if( momParent ){
+		momParent = (HWND)PostMessageA(momParent, WM_CLOSE, 0, 0);
+		MOMParentFound = 1;
