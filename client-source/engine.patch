+	int v32;          // [sp+10h] [bp-14h]@9
+	unsigned int v33; // [sp+Ch] [bp-18h]@19
+	v30 = 2 * AreaRow + 2;
+	if( 2*AreaRow + 2 > 8 ){
+		v30 = 8;
+	}
+	xPos = aXPos;
+	YPos = aYPos;
+	// рисуем средние полные целлы:
+	if( AreaWidth > 0 ){
+		v33 = AreaWidth;
+		v12 = 112 * row;
+		v32 = 112 * row;
