+//----- (th2) -------------------------------------------------------------
+uint __fastcall Rng64(uint range /*= 0xFFFF'FFFFU*/ )
+{
+	return uint((GetRndSeed64() * 0x2545F4914F6CDD1DULL) >> 32) % range;
+}
