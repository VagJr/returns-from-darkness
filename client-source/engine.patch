-			textLength += scale + FontWidthSmall[FontIndexSmall[Codepage[*textTmp]]];
-			textTmp++;
-		}
-	}
-	textTmp = text;             // end
-	if( textLength < maxWidth ) // Center the text if necessary
-	{
-		offset += (maxWidth - textLength) >> 1;
