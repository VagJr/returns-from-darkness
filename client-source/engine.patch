+//----- (0044639F) --------------------------------------------------------
+uchar* DeltaBuildObjects( uchar* dst, DObjectStr* src )
+{
+    size_t size = sizeof(*src) * MaxObjects_127;
+	memcpy(dst, src, size);
+	return dst + size;
+}
