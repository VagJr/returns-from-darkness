+sampler hdMask : register(s2);
+sampler hdStone : register(s3);
+float4 frame : register(c0); // inverse texture dimensions, viewport rows, strength
+float4 hdWorld : register(c1); // anchored world origin, zoom, enabled
+struct PSInput { float2 sp : VPOS; float2 cr : TEXCOORD0; };
+float srgbToLinear1(float c){return c>0.04045?pow(abs((c+0.055)/1.055),2.4):c/12.92;}
+float linearToSrgb1(float c){return c>0.0031308?1.055*pow(abs(c),1.0/2.4)-0.055:c*12.92;}
+float3 toLinear(float3 c){return float3(srgbToLinear1(c.r),srgbToLinear1(c.g),srgbToLinear1(c.b));}
+float3 toSrgb(float3 c){return float3(linearToSrgb1(c.r),linearToSrgb1(c.g),linearToSrgb1(c.b));}
+float3 sampleColor(float2 uv){return tex1D(pl,tex2D(tx,saturate(uv)).r).rgb;}
+float3 highlight(float2 uv){float3 c=toLinear(sampleColor(uv));return c*smoothstep(0.45,1.0,max(c.r,max(c.g,c.b)));}
+// Adaptation of DamnationX's tileClassicTint / ApplyClassicTint (fragment 10).
+// Uses only the bundled atlas, on the floor pixels tagged by the native renderer.
+float3 remasterFloor(float2 uv,float3 original){
+ if(hdWorld.w<0.5||tex2D(hdMask,uv).r<0.5)return original;
+ float2 screen=(uv/frame.xy-0.5)/hdWorld.z;
+ float2 world=float2(screen.x/64+screen.y/32+hdWorld.x,-screen.x/64+screen.y/32+hdWorld.y);
+ float2 stoneUV=float2(world.x/8,world.y/8);
+ float3 art=toLinear(tex2D(hdStone,stoneUV).rgb);
+ float3 mean=0;float count=0;
+ [unroll] for(int j=-1;j<=1;j++)[unroll] for(int i=-1;i<=1;i++){
+  float2 p=uv+float2(i,j)*frame.xy*3;
+  if(tex2D(hdMask,p).r>0.5){mean+=toLinear(sampleColor(p));count+=1;}
+ }
+ mean/=max(count,1);float lum=dot(mean,float3(0.2126,0.7152,0.0722));
+ float3 tint=clamp(mean/max(lum,0.002),0.4,2);
+ float artLum=dot(art,float3(0.2126,0.7152,0.0722));
+ float3 recolored=artLum*max(tint+(art/max(artLum,0.002)-1)*0.5,0);
+ // Preserve game darkness and fog, including black unseen terrain.
+ return toSrgb(saturate(recolored*min(lum/0.045,2.6)));
+}
+float4 main_bloom(PSInput input) : COLOR {
+ float3 base=sampleColor(input.cr);
+ float2 d=frame.xy;
+ float3 glow=highlight(input.cr)*4;
+ glow+=highlight(input.cr+float2(d.x,0))*2;
+ glow+=highlight(input.cr-float2(d.x,0))*2;
+ glow+=highlight(input.cr+float2(0,d.y))*2;
+ glow+=highlight(input.cr-float2(0,d.y))*2;
+ glow+=highlight(input.cr+d)+highlight(input.cr-d);
+ glow+=highlight(input.cr+float2(d.x,-d.y))+highlight(input.cr+float2(-d.x,d.y));
+ base=remasterFloor(input.cr,base);
+ float strength=input.cr.y>=frame.z*frame.y?0:frame.w;
+ return float4(toSrgb(saturate(toLinear(base)+glow*(strength/16.0))),1);
+}
