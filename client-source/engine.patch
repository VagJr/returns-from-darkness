+int __fastcall encode_enemy( int monsterIndex )
+{
+	Monster& monster = Monsters[monsterIndex];
+	int result = monster.TargetIndex;
+	if (monster.flag & MF_5_TARGET_MONSTER) {
+		result += 4;
+	}
+	return result;
