+//----- (0043FC36) --------------------------------------------------------
+void __fastcall AttackType_0_Zombie(uint monsterIndex) // Zombie AI
+	//Zombie AI, by Jarulf Guide:
+	//General
+	
+	//if out of light, exit
+	
+	//R = Rnd[100]
+	
+	//Distance = 1
+	//if R < 2·Intf + 10, do melee attack, exit
+	//continue to stand still
+	
+	//Distance = 2 to 2·Intf + 3
+	//if R < 2·Intf + 10, walk towards target, exit
+	//	continue to stand still
+	
+	//	Distance > 2·Intf + 3
+	//	if R >= 2·Intf + 10, continue to stand still, exit
+	//	calculate new R = Rnd[100]
+	//	if R < 2·Intf + 20, walk in random direction(if blocked, continue to stand still), exit
+	//	continue to walk in the same direction as last time(if blocked, continue to stand still)
+{
+	Monster *monster; // esi@2
+	int monster_Col; // edi@3
+	bool v3; // zf@3
+	int distance_to_target_Row; // ebx@3
+	int distance_to_target_Col; // edi@3
+	int monster_orient_to_target; // eax@11
+	int attack_chance; // eax@20
+	int monster_orientation; // [sp+Ch] [bp-Ch]@3	
+	unsigned int monster_index; // [sp+14h] [bp-4h]@1
+
+	monster_index = monsterIndex;
+	if( monsterIndex < Monsters_Max_Count ){
+		monster = &Monsters[ monsterIndex ];
+		if( !monster->CurAction ){
+			monster_Col = monster->Col;
+			v3 = (FlagMap[ monster->Row ][ monster_Col ] & 2) == 0;
+			distance_to_target_Row = monster->Row - monster->TargetRow;
+			distance_to_target_Col = monster_Col - monster->TargetCol;
+			monster_orientation = monster->Orientation;			
+			if( abs( distance_to_target_Row ) >= 2 || abs( distance_to_target_Col ) >= 2 ){ // if not in melee range...
+				int chase_factor = by(Difficulty, 10, 12, 14, 15, 16, 17, 18, 19, 20) + (GameMode == GM_HARD ? 70 : 0);
+				if (RNG(100) < 2 * monster->intelligenceFactor + chase_factor){ //  Rnd[100] < 2 * mIntF + X
+					int distance_sensitivity = 4;
+					if (GameMode == GM_HARD) {
+						distance_sensitivity += 2;
+					}
+					if( abs( distance_to_target_Row ) >= 2 * monster->intelligenceFactor + distance_sensitivity 
+						|| abs( distance_to_target_Col ) >= 2 * monster->intelligenceFactor + distance_sensitivity) {// if distance is > mIntF * 2 + 3
+						if( RNG(100) < 2 * monster->intelligenceFactor + 4 ){
+							monster_orientation = RNG(8);
+						}
+						MoveToDirectionIfMay( monster_index, monster_orientation );
+					}else{ // walk towards player
+						monster_orient_to_target = MonsterOrientationToTarget( monster_index );
+						Monster_Walks_Towards_Target( monster_index, monster_orient_to_target );
+					}
+				}
+			}else{ // distance = adjacent
+				if (GameMode == GM_HARD) {
+					attack_chance = Difficulty + 91;
+				}
+				else {
+					attack_chance = 5 * monster->intelligenceFactor + by(Difficulty, 14, 30, 40, 42, 44, 46, 48, 49, 50) - (GameMode == GM_EASY ? 5 : 0);
+				}
+				if (RNG(100) < attack_chance){
+					Monster_Start_Attack( monster_index );
+				}
+			}
+			if( !monster->CurAction ){
+				monster->curAnimation = &monster->SpritePtr->animation[ANIM_0_STAY].oriented[ monster->Orientation ];
+			}
+		}
+	}
+	#ifdef REFACTOR
+	if( monsterIndex >= Monsters_Max_Count ){
+		return;
+	}
+	Monster& monster = Monsters[monsterIndex];
+	MonsterSprite& monsterSprite = MonsterSprites[monster.SpriteIndex];
+	if( monster.CurAction ){
+		return;
+	}
+	if( !(FlagMap[ monster.Row ][ monster.Col ] & CF_2_VISIBLE_BY_PLAYER) ){
+		return;
+	}
+	int randFactor = RNG(100);
+	bool meleeAttackAndWalkAllow = randFactor < 2 * monster.intelligenceFactor + 10;
+
+	if( meleeAttackAndWalkAllow ){
+		if( !CheckMaxDistanceToMonsterTarget(monsterIndex, 2) ){
+			if( !CheckMaxDistanceToMonsterTarget(monsterIndex, 2 * monster.intelligenceFactor + 4) ){
+				randFactor = RNG(100);
+				bool randomWalkAllow = randFactor < 2 * monster.intelligenceFactor + 20;
+				int newOrientation = monster.Orientation;// идём в том же направлении что и раньше
+				if( randomWalkAllow ){
+					newOrientation = RNG(8);// выбираем случайное следующее направление
+				}
+				// Идём без обхода препятствия. Другие соседние направления не пробуем
+				MoveToDirectionIfMay(monsterIndex, newOrientation);
+			}else{
+				// Если игрок рядом, двигаемся к нему
+				MoveInOrientOrAbove_2(monsterIndex, MonsterOrientationToTarget(monsterIndex));
+			}
+		}else{
+
+			StartMonsterAttack(monsterIndex);// Если игрок рядом, атакуем его
+		}
+	}
+	if( monster.CurAction == A_0_STAY ){
+		monster.curAnimation = &monsterSprite.animation[ANIM_0_STAY].oriented[monster.Orientation];
+	}
+	#endif
+}
