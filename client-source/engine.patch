+			}
+			else if (key == VK_CONTROL) {
+				//if( !(GetAsyncKeyState(VK_LCONTROL) < 0 && GetAsyncKeyState(VK_RMENU) < 0) ){ // not AltGr // TODO: check if need (testing say no)
+					IsCtrlPressed = true;
