+//----- (0043CC9A) --------------------------------------------------------
+void __fastcall SetMonsterAnimation(int monsterIndex, MonsterAnim* animPtr, int direction)
+{
+	Monster& monster = Monsters[monsterIndex];
+	monster.curAnimation = &animPtr->oriented[direction];
+	monster.AnimationDelayIndex = 0;
