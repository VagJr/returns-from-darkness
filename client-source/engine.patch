+				++player.currentAnimationFrame;
+			}
+		}
+		else if (player.affixFlag & AF_19_FAST_ATTACK_SPEED_2) { // byte2 & 4
+			if (currentAnimationFrame == 2 || (currentAnimationFrame == 5 && RNG(2))) {
+				player.currentAnimationFrame += 1;
+			}
+		}
+		else if (player.affixFlag & AF_18_FAST_ATTACK_SPEED_1 && currentAnimationFrame == 2) { // byte2 & 2
+			player.currentAnimationFrame += 1;
+		}
+	}
+	else { // Zealot speeds
+		if (player.affixFlag & AF_21_FAST_ATTACK_SPEED_4) { // AS 4: -4
+			if (currentAnimationFrame == 2) {
+				player.currentAnimationFrame += 4;
+			}
+		}
+		else if (player.affixFlag & AF_20_FAST_ATTACK_SPEED_3) { // AS 3: -3
+			if (currentAnimationFrame == 2) {
+				player.currentAnimationFrame += 3;
+			}
+		}
+		else if (player.affixFlag & AF_19_FAST_ATTACK_SPEED_2) { // AS 2: -2,5
+			if (currentAnimationFrame == 2) {
+				player.currentAnimationFrame += 2;
+			}
+			else if (currentAnimationFrame == 5 && RNG(2)) {
+				player.currentAnimationFrame += 1;
+			}
+		}
+		else if (player.affixFlag & AF_18_FAST_ATTACK_SPEED_1) { // AS 1: -2
+			if (currentAnimationFrame == 2 || currentAnimationFrame == 5) {
+				player.currentAnimationFrame += 1;
+			}
+		}
+		else {
+			if (currentAnimationFrame == 2) { // AS 0: -1
+				player.currentAnimationFrame += 1;
+			}
+		}
+	}
+
+	if ((player.activeBuffFlag & BF_2_FURY_ACTIVE) && player.fullClassId == PFC_DIMACHAERUS) { // dimachaerus attacks 1 frame daster under fury (onslaught)
+		if (/*player.currentAnimationFrame == 1 || player.currentAnimationFrame == 3 || */player.currentAnimationFrame == 7) {
+			++player.currentAnimationFrame;
+		}
+	}
+
+	for( uchar currentArrowIndex = 0; currentArrowIndex < numberOfArrows; currentArrowIndex++ ){
+		int colOffset = 0;
+		int rowOffset = 0;
+		if( multiArrowFlag ){
+			int deltaRow = player.CursorRow - player.Row;
+			int deltaCol = player.CursorCol - player.Col;
+			int oneOffset;
+			int mult = multiArrowOffset + currentArrowIndex / 2 + 1;
+			if( currentArrowIndex % 2 ){
+				oneOffset = mult;
+			}else{
+				oneOffset = -mult;
+			}
+			if( deltaRow < 0 ){
+				colOffset = oneOffset;
+			}else if( deltaRow > 0 ){
+				colOffset = -oneOffset;
+			}
+
+			if( deltaCol < 0 ){
+				rowOffset = -oneOffset;
+			}else if( deltaCol > 0 ){
+				rowOffset = oneOffset;
+			}
+		}
+
+		bool magicArrowExplosionAllInOne = true;  // elemental type explosion one hit simultaneity
+		int missile = MI_0_NONE_ARROW;
