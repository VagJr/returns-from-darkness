+void LoadDragonMenuPalette()
+{
+	PALETTEENTRY* menuPal = (PALETTEENTRY*)MorMenuPal;
+    for( int i = 0; i < 256; i++ ){
+        ScreenPalette[i].peBlue = menuPal[255 - i].peBlue;
+        ScreenPalette[i].peGreen = menuPal[255 - i].peGreen;
+        ScreenPalette[i].peRed = menuPal[255 - i].peRed;
+    }
+}
