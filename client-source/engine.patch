+			if (is(itemCode, IC_6_LIGHT_ARMOR, IC_7_HELM, IC_8_MID_ARMOR, IC_9_HEAVY_ARMOR, IC_1_SWORD, IC_3_BOW, IC_16_BOOTS) && baseItem.Specialization == IS_BATTLE) {
