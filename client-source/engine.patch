+					if( v13 ){
+						*(uchar*)(v9 - 1) = v6;
+						*(uchar*)(v9 + 1) = v6;
+						*(uchar*)(v9 - WorkingWidth) = v6;
+						*(uchar*)(v9 + WorkingWidth) = v6;
+					}
+					--result;
+					++v9;
+				}while( result );
+				goto LABEL_12;
+			}
+			result = result - 65;
+			--v7;
+			v12 = *(uchar*)v10++;
+			if( v12 ){
+				*(uchar*)(v9 - 1) = v6;
+				v8 -= result;
+				*(uchar*)(v9 + result) = v6;
+				do{
+					*(uchar*)(v9 - WorkingWidth) = v6;
