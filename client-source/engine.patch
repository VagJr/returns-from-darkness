-
-		}else{
-			if( tbl == (unsigned char*)1 ){ //  memmaskset
-				if( mask & 0x80000000 )
-					((unsigned char*)dst)[i] = 0;
-			}
-			else if( tbl ){				//  transparent memxlat
-				if( mask & 0x80000000 )
-					((unsigned char*)dst)[i] = ((unsigned char*)tbl)[((unsigned char*)src)[i]];
