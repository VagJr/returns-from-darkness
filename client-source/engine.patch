+		return false;
+	}else{
+		return ! pi->UberDialogKilled && ( (InstantMurderHero && strcmp(MurderHeroName, name) == 0)
+			//|| is(pi->gameMode, GM_NIGHTMARE, GM_SPEEDRUN) 
+			);
