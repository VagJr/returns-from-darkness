+ if(textureW!=ScreenWidth||textureH!=ScreenHeight){if(maskTexture)maskTexture->Release();maskTexture=nullptr;textureW=ScreenWidth;textureH=ScreenHeight;if(FAILED(device->CreateTexture(textureW,textureH,1,0,D3DFMT_A8R8G8B8,D3DPOOL_MANAGED,&maskTexture,nullptr)))return false;}
