+			if (!(RNG(100) < circling_chance && monsterIndex >= SummonMonsters_Count) 
+				|| !Monster_Circle_Target(monsterIndex, orientationToTarget, monster.curOrientation)) {
+				Monster_Start_Delay(monsterIndex, RNG(attack_delays));
