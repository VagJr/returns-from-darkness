+// get non gameplay random int from 0 to range - 1 ------------------------
+int RandSound(int range)
+{
+	return rand() % range;
+}
+
+// get non gameplay random int from min to max ----------------------------
+int RandSound(int soundMin, int soundMax)
+{
+	return soundMin + rand() % (soundMax - soundMin + 1);
+}
