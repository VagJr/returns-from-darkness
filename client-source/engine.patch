+		do{
+			v4 = *v14;
+			if( *v14 != v12 && Monsters[ v3 ].ActivationCounter ){
+				v5 = v4;
+				SetMonsterAnimation( *v14, &Monsters[ v4 ].SpritePtr->animation[ANIM_4_DIE], Monsters[ v4 ].Orientation );
