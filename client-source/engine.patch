+//----- (0042B200) --------------------------------------------------------
+void __fastcall PepinItemsGeneration( int qlvl )
+{
+	Item& tempItem = Items[MaxItems_255];
+	//if (GameMode != GM_COLISEUM) {
+	Item& healerItem0 = PepinItems[0];
+	Item& healerItem1 = PepinItems[1];
+	Item& healerItem2 = PepinItems[2];
