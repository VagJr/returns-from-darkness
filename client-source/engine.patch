+//----- (0046A925) --------------------------------------------------------
+void RenderCursor()
+{
+	if (!XinputAutoTargettingOff) {
+		return;
+	}
+
+	Object& objectUnderCursor = Objects[Cur.ObjectIndex];
+	if( Cur.GraphicsID == CM_0_INVISIBLE || !( ItemWidth && ItemHeight )){
+		return;
