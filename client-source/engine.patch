+		if( picIndex >= MAX_9000_ITEM_PICS ){
+			if( IsFullScreen ) SwitchFullscreen( 1 );
+			char text[ 128 ];
+			sprintf( text, "The number of item pictures (%i) has been exceeded", picIndex );
+			MessageBoxA( NULL, text, "ERROR", MB_TASKMODAL | MB_ICONERROR );
