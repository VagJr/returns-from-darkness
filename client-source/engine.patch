+void loadMaterial(IDirect3DDevice9 *device){
+ wchar_t path[MAX_PATH];GetModuleFileNameW(nullptr,path,MAX_PATH);wchar_t *tail=wcsrchr(path,L'\\');if(!tail)return;
+ wcscpy(tail+1,L"assets\\remaster\\cathedral-floor-atlas.png");
+ HRESULT initialized=CoInitializeEx(nullptr,COINIT_MULTITHREADED);
+ IWICImagingFactory *factory=nullptr;IWICBitmapDecoder *decoder=nullptr;IWICBitmapFrameDecode *frame=nullptr;IWICFormatConverter *converter=nullptr;UINT w=0,h=0;
