+//----- (th2) -------------------------------------------------------------
+void RestoreLocalGroundItems( uchar dlvl )
+{
+    if( !sgLocals[dlvl].inited ){
+        return;
+    }
+    // Restore all items info
+    ItemsCount = sgLocals[dlvl].countItemsOnMap;
+    for( int i = 0; i < MaxItems_255; i++ ){
+        ItemActive[i] = sgLocals[dlvl].mapItemsFreeIndexes[i];
+    }
+    for( int i = 0; i < MaxItems_255; i++ ){
+        ItemAvailable[i] = sgLocals[dlvl].itemsOnMapIndexesInvers[i];
+    }
+    for( int i = 0; i < MaxItems_255; i++ ){
+        memcpy( &Items[i], &sgLocals[dlvl].items[i], sizeof(Items[i]) );
+    }
+    memcpy( ItemMap, sgLocals[dlvl].itemsOnGroundMap, sizeof( ItemMap ) );
+}
+
+void DeltaRestoreGroundItems(uchar dlvl){
+ if(!RfdOnlineRequested()){RestoreLocalGroundItems(dlvl);return;}
+ // Network delta is the source for shared ground items, including town and late joiners.
+ RestoreLocalGroundItems(dlvl);
+ for(auto &entry:sgLevels[dlvl].items){
+  if(entry.bCmd==ITEM_FREE)continue;
+  if(entry.bCmd==ITEM_GEN_TAKEN){
+   for(int i=ItemsCount-1;i>=0;i--){int id=ItemActive[i];if(entry.info==Items[id]){ItemMap[Items[id].MapRow][Items[id].MapCol]=0;DeleteItem(id,i);}}
+  }else if(entry.bCmd==ITEM_DROP_FLOOR||entry.bCmd==ITEM_GEN_FLOOR){RfdPutGroundItem(entry.mapRow,entry.mapCol,entry.info);}
+ }
+}
