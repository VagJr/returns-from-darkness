+				break;
+			}
+			if( curSizeNeed < 4 ){
+				return 0;
+			}
+			hcursor = LoadCursorA( HInstance, "DIABLO_LINKCURSOR" );
+		LABEL_23:
+			cursorLink->hcursor = hcursor;
+			if( !hcursor ){
+				return hcursor;
+			}
+			break;
+		default:
+			break;
+		}
+	}
