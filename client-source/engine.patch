-	if( sgbRecvLevel[0] ){
-		Expand( &sgbRecvLevel[1], len, sizeof(sgbRecvLevel) - 1);
-	}
-	uchar* data = &sgbRecvLevel[1];
-
-	if( cmd == CMD_83_DLEVEL_JUNK ){
-        DParseJunk( data );
-	}
-	else if( cmd & CMD_DLEVEL ){
-		DLevel& netLevelData = sgLevels[cmd & ~CMD_DLEVEL];
