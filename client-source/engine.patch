+//----- (0041DBDF) --------------------------------------------------------
+char* __fastcall FindFileNameInPath(char* Str)
+{
+	char* result; // eax@1
+	result = strrchr(Str, '\\' );
+	if( result ){
+		if( !*(result + 1) )
+			*result = 0;
+	}
+	return result;
+}
