+	monster.ColDelta = monster.Col;
+	monster.PrevRow = monster.Row;
+	monster.PrevCol = monster.Col;
+	monster.NextRow = monster.Row + deltaRow;
+	monster.NextCol = monster.Col + deltaCol;
+	monster.Row = monster.NextRow;
