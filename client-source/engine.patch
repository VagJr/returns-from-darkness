+		do{
+			str = v5;
+			v9 = *(uint*)v6 + v15;
+			v7 = 0;
+			v8 = v5;
+			while( 1 ){
+				v10 = *(uchar*)v8;
+				if( !*(uchar*)v8 )
+					break;
