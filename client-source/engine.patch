+// Storm's transform blitter has no destination height and cannot clip glyphs.
+// Render edge glyphs into their own bitmap, preserving the existing destination
+// behind transparent runs, then copy only the visible intersection.
+static void RfdDrawClippedMenuGlyph(unsigned char *surface,int width,int height,int x,int y,int glyphWidth,int glyphHeight,HANDLE glyph)
+{
+ if(!surface||!glyph||width<=0||height<=0||glyphWidth<=0||glyphWidth>256||glyphHeight<=0||glyphHeight>256)return;
+ if(x>=width||y>=height||x<=-glyphWidth||y<=-glyphHeight)return;
+ if(x>=0&&y>=0&&glyphWidth<=width-x&&glyphHeight<=height-y){STransBlt(surface,x,y,width,glyph);return;}
+ const int left=std::max(0,x),top=std::max(0,y),right=std::min(width,x+glyphWidth),bottom=std::min(height,y+glyphHeight);
+ if(left>=right||top>=bottom)return;
+ static thread_local std::vector<unsigned char> scratch;
+ scratch.assign(size_t(glyphWidth)*glyphHeight,0);
+ for(int row=top;row<bottom;row++)memcpy(scratch.data()+size_t(row-y)*glyphWidth+left-x,surface+size_t(row)*width+left,right-left);
+ STransBlt(scratch.data(),0,0,glyphWidth,glyph);
+ for(int row=top;row<bottom;row++)memcpy(surface+size_t(row)*width+left,scratch.data()+size_t(row-y)*glyphWidth+left-x,right-left);
+}
