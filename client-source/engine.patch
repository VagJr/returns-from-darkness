+		do{
+			if( result <= v8 ){
+				v11 = result;
+				v9 += result;
+				result = 0;
+			}else{
+				v11 = v8;
+				v9 += v8;
+				result -= v8;
+			}
+			v8 -= v11;
+			if( v8 <= 0 ){
+				v8 = a4;
+				v9 = v9 - WorkingWidth - a4;
+			}
