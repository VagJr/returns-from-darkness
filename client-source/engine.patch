+		while( nDataSize > 0 ){
+			width = (char)*dst++;
+			nDataSize--;
+			if( width < 0 ){
+				width = -width;
+				if( width > 65 ){
+					if( nDataSize <= 0 ) break;
+					nDataSize--;
+					*dst = colorTable[*dst];
+					dst++;
+				}else{
+					LimitToMax( width, nDataSize );
