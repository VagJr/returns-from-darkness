+Node* new_node(ushort key, int degree)
+{
+    Node* node = (Node*) calloc(1, sizeof(*node) + degree * sizeof(Node *));
+    if( node )
+        node->key = key;
+    return node;
+}
+
+void del_trie(Node *root, int degree)
+{
+    if( !root )
+        return;
+    for( int i = 0; i < degree; i++ )
+        del_trie(root->children[i], degree);
+    free(root);
+}
