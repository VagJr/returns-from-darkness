+//----- (2000A220) --------------------------------------------------------
+void __fastcall AnimateProgress( HWND hdlg, int progressPercent )
+{
+	if( ProgressBackground ){
+		SBltROP3(
+			ProgressSurface,
+			ProgressBackground,
+			ProgressWidth,
+			ProgressHeight,
+			ProgressWidth,
+			ProgressSize.cx,
+			0,
+			0xCC0020u );
+	}
+	if( ProgressFill ){
+		SBltROP3(
+			ProgressSurface,
+			ProgressFill,
+            ProgressWidth * progressPercent / 100,
+			ProgressHeight,
+			ProgressWidth,
+			ProgressFillSize.cx,
+			0,
+			0xCC0020u );
+	}
+	struct tagRECT rect;
+	GetWindowRect( GetDlgItem( hdlg, ID_PROGRESS_BAR ), &rect );
+	ScreenToClient( hdlg, (LPPOINT) &rect );
+	ScreenToClient( hdlg, (LPPOINT) &rect.right );
+	InvalidateRect( hdlg, &rect, 0 );
+}
