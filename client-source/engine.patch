+	FineMap[ row + 1 ][ col ] = tileSquare.left + 1;
+	FineMap[ row ][ col + 1 ] = tileSquare.right + 1;
+	FineMap[ row + 1 ][ col + 1 ] = tileSquare.down + 1;
+}
