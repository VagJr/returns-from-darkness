-int get_bbox(GIF* gif, ushort* w, ushort* h, ushort* x, ushort* y)
-{
-    int i, j, k;
-    int left, right, top, bottom;
-    left = gif->w; right = 0;
-    top = gif->h; bottom = 0;
-    k = 0;
-    for( i = 0; i < gif->h; i++ ){
-        for( j = 0; j < gif->w; j++, k++ ){
-            if( gif->frame[k] != gif->back[k] ){
-                if( j < left)   left    = j;
-                if( j > right)  right   = j;
-                if( i < top)    top     = i;
-                if( i > bottom) bottom  = i;
-            }
-        }
-    }
-    if( left != gif->w && top != gif->h ){
-        *x = left; *y = top;
-        *w = right - left + 1;
-        *h = bottom - top + 1;
-        return 1;
-    }else{
-        return 0;
-    }
-}
