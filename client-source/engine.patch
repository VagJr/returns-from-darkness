+{
+    LastPlayerInfo charInfo;// [sp+Ch] [bp-4F4h]@8
+	int firstFreeSlot = GetSlotByHeroName(newSaveInfo->Name);
+	if( firstFreeSlot >= MaxSaveSlots - 1 ){ // если имя не занято, ищем свободный слот, иначе перезаписываем
