+bool SetItem_IsSetUniqueItem( Item* item )
+{
+	if( item->ItemCode == IC_M1_NONE )
+	{
+		return false;
+	}
+
+	if( !item->Identified )
+	{
+		return false;
+	}
+
+	return item->MagicLevel == ML_3_SET;
+}
