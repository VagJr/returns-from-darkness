-	if( v4 ){
-		if( v1 ){
-			memcpy( v4, v1, sizeof(Player) * (PlayersMax_4 + 1) ); // 5-th player struct reserved for special save operations
-			free( v1 );
-		}
-		result = v4;
-	}else{
-		result = v1;
-	}
-	return result;
-}
