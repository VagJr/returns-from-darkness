+//----- (th2) ------------------------------------------------------------
+void SetBackgroundFps()
+{
+	extern int OldMaxFps;
+	if( ! IsMainWindowActive || IsMainWindowMinimized ){
+		if( MaxFPS > ENGINE_FPS ){ OldMaxFps = MaxFPS; }
+		MaxFPS = ENGINE_FPS;
+	}else{
+		if( OldMaxFps > ENGINE_FPS ){ MaxFPS = OldMaxFps; }
+		OldMaxFps = ENGINE_FPS;
+	}
+}
