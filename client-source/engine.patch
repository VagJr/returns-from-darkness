+namespace {
+std::string profile(){char value[4096]={};DWORD n=GetEnvironmentVariableA("RFD_PROFILE",value,sizeof(value));return n&&n<sizeof(value)?value:"";}
+}
+bool RfdAcquireInstance(){
+ static HANDLE guard=nullptr;
+ std::string account=profile();
+ std::string name="Local\\ReturnsFromDarknessTH3Offline";
+ if(!account.empty()){
+  unsigned long long hash=14695981039346656037ull;
+  for(unsigned char c:account){if(c>='A'&&c<='Z')c+=32;hash=(hash^c)*1099511628211ull;}
+  char suffix[32];sprintf(suffix,"%016llx",hash);name="Local\\ReturnsFromDarknessTH3Account_";name+=suffix;
+ }
+ SetLastError(0);guard=CreateMutexA(nullptr,FALSE,name.c_str());
+ return guard&&GetLastError()!=ERROR_ALREADY_EXISTS;
+}
+char *RfdConfigPath(){
+ static std::string path=[](){std::string p=profile();return p.empty()?std::string("config.ini"):p+"\\config.ini";}();
+ return path.data();
+}
+void RfdConfigureWindow(){
+ if(profile().empty())return;
+ char mode[8]={};GetEnvironmentVariableA("RFD_WINDOWED_TEST",mode,sizeof(mode));
+ const bool test=mode[0]=='1';IsFullScreen=!test;BigWin=!test;
+}
+void RfdTestWindow(int &width,int &height,int &x,int &y){
+ char mode[8]={};if(!GetEnvironmentVariableA("RFD_WINDOWED_TEST",mode,sizeof(mode))||mode[0]!='1')return;
+ width=std::min(960,GetSystemMetrics(SM_CXSCREEN)-80);height=std::min(540,GetSystemMetrics(SM_CYSCREEN)-120);
+ char slot[8]={};GetEnvironmentVariableA("RFD_WINDOW_SLOT",slot,sizeof(slot));
+ x=slot[0]=='2'?std::max(0,GetSystemMetrics(SM_CXSCREEN)-width-30):20;y=slot[0]=='2'?90:20;
+}
+const char *RfdWindowTitle(){
+ static std::string title=[](){std::string t="Diablo 1 HD - Returns from Darkness",p=profile();
+  if(!p.empty()){const auto parent=std::filesystem::path(p).parent_path().filename().string();if(!parent.empty())t+=" ["+parent+"]";}return t;}();
+ return title.c_str();
+}
