+bool __fastcall ItemPlace( int row, int col, int playerIndex )
+{
+	return ! ( MonsterMap[ row ][ col ]
+			|| PlayerMap[ row ][ col ]
+			|| ItemMap[ row ][ col ]
+			|| ObjectsMap[ row ][ col ]
+			|| FlagMap[ row ][ col ] & CF_8_FORBIDDEN
+			|| TileBlockWalking[FineMap[ row ][ col ]] );
