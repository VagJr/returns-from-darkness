+//----- (00456284) --------------------------------------------------------
+void __fastcall GetSaveArchivePath( char (&saveArchivePath)[MAX_PATH], int stringSize, int slotNum, int isHellfire )
+{
+	char buffer[MAX_PATH];
+	DWORD profileLength=GetEnvironmentVariableA("RFD_PROFILE",saveArchivePath,MAX_PATH);
+	if(profileLength>=MAX_PATH) TerminateWithError("Project profile path is too long");
+	if(!profileLength && !GetModuleFileNameA(HInstance, saveArchivePath, MAX_PATH) ){
+		TerminateWithError("Unable to get save directory");
+	}
+	char* pathEnd = profileLength ? nullptr : strrchr(saveArchivePath, '\\'); // поиск справа
+	if( pathEnd ){
+		*pathEnd = 0;// обрезаем "\\" и имя exe
+	}
+	if(profileLength && SaveFolder){std::string folder=std::string(saveArchivePath)+"\\"+SaveFolders[SaveType()];CreateDirectoryA(folder.c_str(),nullptr);}
+	sprintf(buffer, SaveArchiveNames[SaveType()], "\\", SaveFolder ? SaveFolders[SaveType()] : "", LoadOnStart && AutoLoadSlot != slotNum ? 'X' : slotNum);
+	strcat(saveArchivePath, buffer);
+	_strlwr(saveArchivePath);// неоригинальное CharLower(saveFullName);
+}
