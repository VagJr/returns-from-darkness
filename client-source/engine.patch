+void __fastcall DrawTileGrid(uchar* dst, uchar color /*= 194*/)
+{
+	dst += 2 * (16 - 1);
+	for( int i = 1; i <= 16; ++i, dst -= WorkingWidth + 2 ){
+		if( (size_t)dst < (size_t)WorkingSurfaceDrawBegin ){ break; }
+		dst[0] = dst[2 * 2 * i - 1] = 194;
+	}
+}
