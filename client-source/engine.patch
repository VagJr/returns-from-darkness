+//----- (00446138) --------------------------------------------------------
+void MegaFreePackets()
+{
+    while (sgpMegaPkt) {
+		sgpCurrPkt = sgpMegaPkt->pNext;
+		FreeMem(sgpMegaPkt);
+		sgpMegaPkt = sgpCurrPkt;
+	}
+	// NOTE: both sgpMegaPkt & sgpCurrPkt are NULL
+}
