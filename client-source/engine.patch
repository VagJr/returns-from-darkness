+int __fastcall InvPutItem(int playerIndex, int row /*= -1*/, int col /*= -1*/)
+{
+	int itemIndex = -1;
+	Player& player = Players[playerIndex];
+	if( col == -1 ){ row = player.Row; col = player.Col; }
