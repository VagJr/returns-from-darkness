+	int result; // eax@1
+	char v6;    // dl@1
+	int v7;     // ecx@1
+	int v8;     // ebx@1
+	int v9;     // edi@1
+	int v10;    // esi@1
+	int v11;    // edx@15
+	char v12;   // dh@4
+	char v13;   // dh@9
