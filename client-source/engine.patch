+                }
+            }
+            
+            constexpr int TITLE_BUF_LEN = 32;
+            char titleBuf[ TITLE_BUF_LEN ];
+            if( GameMode == GM_COLISEUM ){
+				LoadStringA( HInstance, STR_79_Coliseum_char, titleBuf, TITLE_BUF_LEN - 1 );
+			}else if( IsMultiplayer() == 1 ){
+                LoadStringA( HInstance, STR_28_Multi_char, titleBuf, TITLE_BUF_LEN - 1 );
+            }else{
+                LoadStringA( HInstance, STR_29_Single_char, titleBuf, TITLE_BUF_LEN - 1 );
