-	void (*redrawColor)(const int&) = nullptr;
-
-	switch( Dungeon->graphType ){
-	case DT_0_TOWN : cutColors = 128u; redrawColor = color::town;    break;
-	case DT_4_HELL : cutColors =  16u; redrawColor = color::dungeon; break;
