+	int v9;  // ebx@4
+	int v10; // esi@4
+	int v11; // eax@6
+	int v12; // eax@10
+	int v13; // edi@10
+	int v14; // esi@10
+	int v15; // eax@4
+	int v16; // eax@10
+	int v17; // [sp+Ch] [bp-4h]@1
