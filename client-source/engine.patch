+// Фоллены разбегаются после убийства одного из них 
+//----- (004442F6) --------------------------------------------------------
+void __fastcall BewareNearMonsters( const int row, const int col )
+{
+    for( int i = 0; i < MonstersCount; i++ ){
+	    Monster& monster = Monsters[MonsterIndexes[i]];
+	    
+	    int rundist = 0;
+        switch( monster.SpritePtr->baseMonsterIndex ){
+            case BM_213_POISONED_ONE:
+            case BM_5_FALLEN_ONE:
+                rundist = 6;
+                break;
+            case BM_155_FALLEN_ONE:
+            case BM_157_YELLOW_ONE:
+                rundist = 5;
+                break;
+            case BM_4_GREMLIN:
+            case BM_189_CARVER:
+                rundist = 4;
+                break;
+            //case BM_6_GRAVE_DIGGER:
+            case BM_12_IMP:
+            //case BM_14_SOUL_HUNTER:
+                rundist = 3;
+                break;
+            //case BM_7_SKELETON:
+            case BM_13_DARK_ONE:
+            //case BM_15_TOMB_SLAVE:
+                rundist = 2;
+                break;
+        }
+        
+        if( monster.AttackIndex == AT_8_Fallen_One
+            && Difficulty == DL_0_HORROR
+			&& GameMode != GM_HARD // hard mode fallen are fearless ^_^
+            && rundist
+            && abs( row - monster.Row ) < 5
+            && abs( col - monster.Col ) < 5
+            && ( monster.CurrentLife & ~63) > 0 ){
+                monster.State = MS_2_RETREAT;
+                monster.stateParam = rundist;
+                monster.Orientation = OrientationToTarget( row, col,
+                    monster.Row, monster.Col
+                    // broken original code
+                    // Monsters[i].Row, Monsters[i].Col
+                    );
+        }
+    }
+}
