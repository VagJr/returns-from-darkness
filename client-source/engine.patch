+//----- (0041DBF7) -------------------------------------------------------- FileIO
+int __fastcall OpenMPQfromCD(char (&str)[MAX_PATH], char* edx0, int a2, int aHandle)
+{
+	DWORD v4;               // eax@1
+	const char* v5;          // edi@1
+	const char* v6;          // esi@5
+	const char* v7;          // ebx@6
+	int result;             // eax@11
+	char v9;                // al@7
+	char RootPathName[MAX_PATH]; // [sp+Ch] [bp-108h]@1
+	v5 = edx0;
+	v4 = GetLogicalDriveStringsA(MAX_PATH, RootPathName);
+	if( !v4 )
+		goto LABEL_11;
+	if( v4 > 0x104 )
+		goto LABEL_11;
+	while( *v5 == 92 )
+		++v5;
+	v6 = RootPathName;
+	if( RootPathName[0] ){
+		while( 1 ){
+			v7 = v6;
+			do
+			v9 = * v6++;
+			while( v9 );
+			if( GetDriveTypeA(v7) == 5 ){
+				strcpy(str, v7);
+				strcat(str, v5);
+				if( SFileOpenArchive(str, a2, 1, (MPQ**)aHandle) )
+					break;
+			}
+			if( !*v6 )
+				goto LABEL_11;
+		}
+		result = 1;
+	}else{
+LABEL_11:
+		result = 0;
+	}
+	// For NoCD fix
+	// return 1;
+	return result;
+}
