+bool hasSpecialization( uchar classId, uchar subclassId )
+{
+    return (classId == PC_2_MAGE && subclassId == PSC_MAGE_SUMMONER)
+        || (classId == PC_5_SAVAGE && subclassId == PSC_SAVAGE_GLADIATOR);
+}
