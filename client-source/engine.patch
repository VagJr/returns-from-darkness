+{
+	if( (uint)playerIndex >= PlayersMax_4 ) TerminateWithError("SyncInitPlr: illegal player %d", playerIndex);
+	SetPlrAnims(playerIndex);
+	SyncInitPlrPos(playerIndex);
+}
