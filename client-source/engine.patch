-//----- (00418A0F) --------------------------------------------------------
-void InitializeHashSource()
-{
-	uint seed = 0x100001;
-	for (int loop1 = 0; loop1 < 256; ++loop1) {
-		for (int loop2 = 0; loop2 < 5; ++loop2) {
-			seed = (seed * 0x7D + 3) % 0x2AAAAB;
-			uint rand1 = seed & 0xFFFF;
-			seed = (seed * 0x7D + 3) % 0x2AAAAB;
-			uint rand2 = seed & 0xFFFF;
-			HashSource[loop2][loop1] = (rand1 << 16) | rand2;
-		}
-	}
-}
