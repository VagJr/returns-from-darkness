+				player.SpellType = SO_4_NONE;
+			}
+		}
+	}
+	++player.CurAnimFrameCount;
+	if( Dungeon->genType || Dungeon->isQuest ){
+		if( player.currentAnimationFrame >= player.SpellAnimationFrameCount ){
