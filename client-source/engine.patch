+  SetPropA(ghMainWnd,"RFD_ACCOUNT_HASH_HI",reinterpret_cast<HANDLE>(static_cast<uintptr_t>(static_cast<uint32_t>(hash>>32))));
+  SetPropA(ghMainWnd,"RFD_ACCOUNT_STATE",reinterpret_cast<HANDLE>(1));
