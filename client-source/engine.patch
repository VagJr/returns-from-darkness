+//----- (0042B9A3) --------------------------------------------------------
+int __fastcall CreateMagicItemFormSlainHero( int row, int col, int itemCode, int itemGfxId, int sendMsg, int delta )
+{
+	int itemIndex = -1;
+	int magicCode = itemCode == IC_10_STAFF ? MC_23_STAFF : MC_0_NONE;
