+	// a3 += Screen_LeftBorder;
+
+	uint str = (uint)sstr;
+	v14 = 0;
+	v5 = str;
+	v15 = x;
+	if( *(uchar*)str ){
+		v6 = (int)&YOffsetHashTable[y];
