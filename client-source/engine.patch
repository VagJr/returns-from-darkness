+ if(row<0||col<0||row>=112||col>=112||info.baseItemIndex<0||info.baseItemIndex>=count_BaseItems)return -1;
+ // Match the complete generation identity, including the 64-bit seed, without moving an existing item.
+ for(int i=0;i<ItemsCount;i++){int id=ItemActive[i];if(info==Items[id])return id;}
+ RfdLootRandomScope random;int id=-1;if(!GetItemSpace(row,col,id,false,ItemSpaceOk))return -1;
+ auto &item=Items[id];const int groundRow=item.MapRow,groundCol=item.MapCol;item.saveVersion=info.saveVersion;
+ RecreateItem(id,info.baseItemIndex,info.dropType,info.seed,info.amount,info.magicLevelAndIdentified,info.genVersion,info.quality,info.magicFind,info.uniqIndex,info.enchantIndexes,info.quenchAffix,info.quenchLevel,info.socketsAdded,info.sockets,info.difficulty,info.flag);
+ item.CurDurability=info.curDurability;item.BaseDurability=info.baseDurability;item.CurCharges=info.curCharges;item.BaseCharges=info.baseCharges;
+ // RecreateItem normalizes gold/useful items. Keep the sender's identity for delta and pickup acknowledgements.
+ item.seed=info.seed;item.genVersion=info.genVersion;item.dropType=info.dropType;item.quality=info.quality;item.magicFindSeed=info.magicFind;item.uniqIndexSeed=info.uniqIndex;
