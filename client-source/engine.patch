+			if (baseItem.itemLevel == 64 && (Difficulty < DL_3_CRUCIBLE || Difficulty > DL_4_TORMENT)) { continue; }
+			if (baseItem.itemLevel == 104 && (Difficulty < DL_5_AGONY || Difficulty > DL_6_TERROR)) { continue; }
+			if (baseItem.itemLevel == 144 && Difficulty < DL_7_DESTRUCTION) { continue; }
