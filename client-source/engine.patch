+void __fastcall LoadGameMenuHandler(int a1, int a2)
+{
+	PlayersSpellcastQueue[CurrentPlayerIndex] = {};
+	PlayerWall[CurrentPlayerIndex] = {};
+	ProcHandler prevHandler = SetWindowProc(DisableInputWindowProc);
