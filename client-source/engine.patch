+//					DamageMonsterByPlayer(monsterIndex, playerIndex, reflectDamage);// Not mulReflectDamage?  Using reflectDamage causes monster HP desync
+					DamageMonsterByPlayer(monsterIndex, playerIndex, mulReflectDamage);
