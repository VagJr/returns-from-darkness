+ FILE *file=fopen((menuQaCapture.substr(0,split)+"\\menu-capture-state.json").c_str(),"w");
+ if(file){fprintf(file,"{\"captured\":%s,\"reason\":\"%s\",\"source\":\"%s\",\"captureForcesPaint\":false}",captured?"true":"false",reason,source);fclose(file);}
