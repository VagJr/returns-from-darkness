+		return;
+	}
+	SetPlayerOld(playerIndex);
+	if( !IsDirectionClearForPlayer(playerIndex, direction) ){
+		return;
+	}
+	player.NextRow = changeRow + player.Row;
+	player.NextCol = changeCol + player.Col;
