+int __fastcall CellFreeForPlayerForceMove(int playerIndex, int row, int col)
+{
+	Player& player = Players[playerIndex];
+	if( row == player.TargetRow && col == player.TargetCol ){
+		return true;
+	}
+	return CellFreeForPlayer(playerIndex, row, col);
+}
