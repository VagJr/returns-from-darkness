+				v22 = *(ushort*)(v10 + 2);
+				CurTileID = *(ushort*)(v10 + 2);
+				if( v22 )
+					DrawDunCelTrans(v26 + 32);
+			}
+			++tileInCell;
+			v10 += 4;
+		}while( tileInCell < (MaxTilesInCell >> 1) - 1 );
+	}
+	DrawDynamicObjects(dst, v23, col, curTileInCell, a5, a6, a7, 0);
+	result = v24;
+	DarkLevel = v8;
+	TransparentMode = v7;
+	WallIndex = v24;
+}
