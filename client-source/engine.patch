+//----- ( Xorshift64* ) ---------------------------------------------------
+u64 GetRndSeed64()
+{
+	Rand64UsingCounter++;
+	u64 x = RandomSeed64;
+	x ^= x >> 12;
+	x ^= x << 25;
+	x ^= x >> 27;
+	return RandomSeed64 = x;
+}
