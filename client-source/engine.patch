+//----- (0041B3F0) -------------------------------------------------------- menu
+void __fastcall SaveGameMenuHandler(int a1, int a2)
+{
+	if( Cur.GraphicsID == CM_1_NORMAL_HAND ){
+		if( Players[CurrentPlayerIndex].CurAction == PCA_8_DEATH || IsPlayerDead ){
