-			}
-			return 1;
-		}
-	}
-	if( ! (packet->info.dropType & D_PREGEN) ){
-		return 0;
-	}
-	for( int itemInfoIndex = 0; itemInfoIndex < MaxItems_255; itemInfoIndex++ ){
