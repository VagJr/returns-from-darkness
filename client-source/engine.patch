+//----- (00446374) --------------------------------------------------------
+uchar* DeltaBuildItems( uchar* dst, TCmdPItem* src )
+{
+	for( int i = 0; i < MaxItems_255; i++, src++ ){
+		if( src->bCmd == INIT_VAL ){
+			*dst++ = INIT_VAL;
+		}else{
+			memcpy(dst, src, sizeof( *src ));
+			dst += sizeof( *src );
+		}
+	}
+	return dst;
+}
