+			curSize = 16;
+			if( !cursorLink ){
+				break;
+			}
+			if( curSizeNeed < 16 ){
+				return 0;
+			}
+			*cursorLink = CursorLink1;
+			break;
+		case 3:
+			curSize = 4;
+			if( !cursorLink ){
+				break;
+			}
+			if( curSizeNeed < 4 ){
+				return 0;
+			}
+			hcursor = LoadCursorA( HInstance, "DIABLO_ARROWCURSOR" );
+			goto LABEL_23;
+		case 4:
+			curSize = 4;
+			if( !cursorLink ){
+				break;
+			}
+			if( curSizeNeed < 4 ){
+				return 0;
+			}
+			hcursor = LoadCursorA( HInstance, "DIABLOIBEAM" );
