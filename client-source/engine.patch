+void __fastcall AnimateDialogTitle( HWND hdlg )
+{
+	HWND hdlg_1; // esi@1
+	TextWin *dlgData; // edi@1
+	HWND staticControl; // ebp@1
+	int nextAnimTitleFrame; // eax@6
