+// Original animated Tchernobog vessel silhouettes, composed around the RFD orb.
+sampler2D visibility : register(s0);
+sampler2D animation : register(s1);
+float4 vessel : register(c0);
+float4 silhouette : register(c2); // source glass center x/y and radius
+float4 main_vessel(float2 uv : TEXCOORD0) : COLOR0 {
+ float frame=floor(fmod(vessel.y*24,48));
+ float2 tile=float2(fmod(frame,8),floor(frame/8));
+ float4 art=tex2D(animation,(tile*256+uv*256)/float2(2048,1536));
+ float2 source=uv*256;
+ float radius=length((source-silhouette.xy)/silhouette.z);
+ art.a*=smoothstep(.85,.98,radius)*tex2D(visibility,uv).a;
+ // The CPU visibility bitmap already follows the original wing, full lower
+ // carving and plinth. Do not impose another radial/narrow-body crop here:
+ // it used to remove carved extremities and make the guardians look severed.
+ // Retain the source PNG alpha; no lower anatomy is generated or extended.
+ // Its thin inherited gold rule becomes aged silver alongside the new HUD.
+ float stone=dot(art.rgb,float3(.299,.587,.114));
+ art.rgb=stone*float3(.98,1,1.025);
+ // The source top rule belongs to its old belt strip, not to the statues.
+ art.a*=smoothstep(9,11,source.y);
+ return art;
+}
