+//----- (00456227) --------------------------------------------------------
+bool __fastcall OpenArchiveWrite( bool isAutoSave, int heroSlot )
+{
+	char buffer[MAX_PATH];
+	GetSaveArchivePath(buffer, MAX_PATH, heroSlot, true);
+	if(RfdOnlineRequested()){
+  projectSaveTarget=buffer;projectPendingSave=projectSaveTarget+".pending";
+  if(GetFileAttributesA(buffer)!=INVALID_FILE_ATTRIBUTES&&!CopyFileA(buffer,projectPendingSave.c_str(),FALSE)){projectPendingSave.clear();AddWorldMessage("Unable to prepare character checkpoint. Previous save preserved.");return false;}
+  if(!MpqOpenArchive(projectPendingSave.data(),false,heroSlot)){projectPendingSave.clear();return false;}return true;
+ }
+ return MpqOpenArchive(buffer, false, heroSlot);
+}
+
+//----- (0045632F) --------------------------------------------------------
+void __fastcall CloseArchiveWrite( bool clearHashTables, int heroSlot )
+{
+	char buffer[MAX_PATH];
+	GetSaveArchivePath(buffer, MAX_PATH, heroSlot, true);
+	if(!projectPendingSave.empty()){
+  bool written=MpqCloseArchive(projectPendingSave.data(),clearHashTables,heroSlot);
+  if(written){HANDLE file=CreateFileA(projectPendingSave.c_str(),GENERIC_WRITE,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);if(file!=INVALID_HANDLE_VALUE){written=FlushFileBuffers(file)!=FALSE;CloseHandle(file);}else written=false;}
+  if(written){std::string backup=projectSaveTarget+".bak";written=GetFileAttributesA(projectSaveTarget.c_str())==INVALID_FILE_ATTRIBUTES?MoveFileExA(projectPendingSave.c_str(),projectSaveTarget.c_str(),MOVEFILE_WRITE_THROUGH)!=FALSE:ReplaceFileA(projectSaveTarget.c_str(),projectPendingSave.c_str(),backup.c_str(),0,nullptr,nullptr)!=FALSE;}
+  projectPendingSave.clear();if(!written){AddWorldMessage("Character checkpoint failed. Previous save preserved.");return;}
+ }else MpqCloseArchive(buffer, clearHashTables, heroSlot);
+}
