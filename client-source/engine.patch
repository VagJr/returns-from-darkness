+//----- (0043CCD8) --------------------------------------------------------
+void __fastcall CheckMonsterUnderArch(int monsterIndex)
+{
+	Monster& monster = Monsters[monsterIndex];
+	if( monster.Row <= 0 ){
+		monster.flag &= ~MF_14_UNDER_ARCH;
