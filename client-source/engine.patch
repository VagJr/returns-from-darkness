+enum Game_Param: ushort { CurSaveVersion = 25, CurItemGenVersion = 7 }; // при релизе архив версий можно будет очиситить и запретить загружать старые версии, либо сделать релизный идентификатор сейвов 'HEL3'
+struct StructVersion { ushort num; size_t size; };
+template<typename T> constexpr size_t StructSize(ushort version)
+{
+	size_t size = 0;
+	for( auto& v: T::versions ){
+		size = v.size;
+		if( version >= v.num ) break;
+	}
+	return size;
+}
