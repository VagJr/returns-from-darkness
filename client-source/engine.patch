+LABEL_11:
+	if( MaybeInProgress ){
+	LABEL_12:
+		DestroyWindow( progressWindow );
+		MaybeInProgress = 0;
+	}
+	if( MaybeProgressResult != 2 && MaybeProgressResult != -1 ){
+		return 1;
+	}
+	return 0;
+}
