+void __fastcall AttackType_30_Lachdanan(uint monsterIndex) // Lachdanan AI 
+{
+	if( monsterIndex >= Monsters_Max_Count ){
+		return;
+	}
+	Monster& monster = Monsters[monsterIndex];
