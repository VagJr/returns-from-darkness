+//----- (00716600) --------------------------------------------------------
+void __fastcall LoadSPTownMap(TileSquare* townTiles)
+{
+	Player& player = Players[CurrentPlayerIndex];
+	auto& clvlReq = ClvlReqsForEnterInDungeon[ Difficulty ];
+	if( !(player.CharLevel >= clvlReq[ DD_1_CATACOMB ] || player.OpenedTownDoors & BIT(DD_1_CATACOMB))){ // закрыть катакомбы
+		SetTileSquare(townTiles, 48, 20, 320);
+	}
+
+	if( !(player.CharLevel >= clvlReq[ DD_2_CAVE ] || player.OpenedTownDoors & BIT(DD_2_CAVE))){ // закрыть пещеры
+		SetTileSquare(townTiles, 16, 68, 332);
+		SetTileSquare(townTiles, 16, 70, 331);
+	}
+
+	if( !(player.CharLevel >= clvlReq[ DD_3_HELL ] || player.OpenedTownDoors & BIT(DD_3_HELL)) ){ // закрыть ад
+		for( int row = 36; row < 46; row++ ){
+			SetTileSquare(townTiles, row, 78, RNG(4) + 1);// случайные тайлы травы
+		}
+	}
+
+	if( player.CharLevel >= clvlReq[ DD_4_ABYSS ] || player.OpenedTownDoors & BIT(DD_4_ABYSS) ){
+		FillDMap3OpenedAbyss();
+	}else{
+		FillTownMap1ClosedAbyss();
+	}
+
+	if( player.CharLevel >= clvlReq[ DD_5_CRYPT ] || player.OpenedTownDoors & BIT(DD_5_CRYPT) ){
+		FillDMap1OpenedCrypt();
+	}else{
+		FillTownMap2ClosedCrypt();
+	}
+}
