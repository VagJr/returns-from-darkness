+//----- (0044508C) --------------------------------------------------------
+bool __fastcall MonsterTalking(uint monsterIndex)
+{
+	return monsterIndex < Monsters_Max_Count && is( Monsters[monsterIndex].State, MS_6_TALK, MS_7_WAIT_TO_TALK);
+}
