-			if (attacker.CurrentLife > attacker.BaseLife) {
-				attacker.CurrentLife = attacker.BaseLife;
-			}
-		}
-	}
-
-	defender.CurrentLife -= damage;
-	if( (defender.CurrentLife & ~63) <= 0 ){
-        KillMonsterByMonster(attackerIndex, defenderIndex);
