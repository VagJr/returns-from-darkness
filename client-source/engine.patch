+bool qaOwnedClientVisible(const RECT &bounds,const char *&reason){
+ DWORD process=GetCurrentProcessId(),foregroundOwner=0;
+ GetWindowThreadProcessId(GetForegroundWindow(),&foregroundOwner);
+ if(foregroundOwner!=process){reason="game-not-in-foreground";return false;}
+ if(!IsWindowVisible(ghMainWnd)||IsIconic(ghMainWnd)){reason="game-window-not-visible";return false;}
+ // Storm uses top-level popups for its menu controls. Those belong to this
+ // process, but another application's window above the client must block a
+ // composition readback rather than become part of a saved game image.
+ using DwmAttributeProc=HRESULT (WINAPI *)(HWND,DWORD,PVOID,DWORD);
+ auto dwm=reinterpret_cast<DwmAttributeProc>(GetProcAddress(GetModuleHandleW(L"dwmapi.dll"),"DwmGetWindowAttribute"));
+ for(HWND window=GetTopWindow(nullptr);window;window=GetWindow(window,GW_HWNDNEXT)){
+  if(window==ghMainWnd)return true;
+  DWORD owner=0;GetWindowThreadProcessId(window,&owner);
+  if(owner==process||!IsWindowVisible(window)||IsIconic(window))continue;
+  DWORD cloaked=0;if(dwm&&SUCCEEDED(dwm(window,14,&cloaked,sizeof(cloaked)))&&cloaked)continue;
+  RECT other{},overlap{};
+  if(GetWindowRect(window,&other)&&IntersectRect(&overlap,&bounds,&other)){
+   reason="game-client-obscured";return false;
+  }
+ }
+ reason="game-window-not-in-z-order";return false;
+}
