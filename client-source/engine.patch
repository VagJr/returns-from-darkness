+			if (itemCode == IC_3_BOW) {
+				if (fullClassId == PFC_SHINOBI || fullClassId == PFC_TEMPLAR) {// shinobi & templar have 10% to get xbows, because they are better off with their class weapons (shuriken/mallet)
+					if (RNG(100) < 90) {
+						continue;
