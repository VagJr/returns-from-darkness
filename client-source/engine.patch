+#include "stdafx.h"
+#include <wincodec.h>
+extern bool MainMainMenu;
+extern bool RfdMenuFooter(unsigned char*,int,int);
+extern PALETTEENTRY MenuPalette[256];
+
+namespace {
+IDirect3DTexture9 *logo=nullptr;
+IDirect3DTexture9 *footer=nullptr;
+IDirect3DStateBlock9 *menuState=nullptr;
+std::vector<IDirect3DTexture9*> logoFrames;
+IDirect3DDevice9 *owner=nullptr;
+bool attempted=false;
+void loadLogo(IDirect3DDevice9 *dev){
+ wchar_t path[MAX_PATH];GetModuleFileNameW(nullptr,path,MAX_PATH);
+ wchar_t *tail=wcsrchr(path,L'\\');if(!tail)return;wcscpy(tail+1,L"assets\\project-logo.gif");
+ const HRESULT initialized=CoInitializeEx(nullptr,COINIT_MULTITHREADED);
+ IWICImagingFactory *factory=nullptr;IWICBitmapDecoder *decoder=nullptr;
+ IWICBitmapFrameDecode *frame=nullptr;IWICFormatConverter *converter=nullptr;
+ UINT width=0,height=0;
+ if(SUCCEEDED(CoCreateInstance(CLSID_WICImagingFactory,nullptr,CLSCTX_INPROC_SERVER,IID_PPV_ARGS(&factory)))&&
+    SUCCEEDED(factory->CreateDecoderFromFilename(path,nullptr,GENERIC_READ,WICDecodeMetadataCacheOnLoad,&decoder))&&
+    decoder){
+     UINT count=0;decoder->GetFrameCount(&count);
+     for(UINT i=0;i<std::min(count,120u);i++){
+      IDirect3DTexture9 *texture=nullptr;
+      if(SUCCEEDED(decoder->GetFrame(i,&frame))&&SUCCEEDED(factory->CreateFormatConverter(&converter))&&
+       SUCCEEDED(converter->Initialize(frame,GUID_WICPixelFormat32bppBGRA,WICBitmapDitherTypeNone,nullptr,0,WICBitmapPaletteTypeCustom))&&
+       SUCCEEDED(converter->GetSize(&width,&height))&&width&&height&&width<=4096&&height<=4096&&
+       SUCCEEDED(dev->CreateTexture(width,height,1,0,D3DFMT_A8R8G8B8,D3DPOOL_MANAGED,&texture,nullptr))){
+        D3DLOCKED_RECT locked;
+        if(SUCCEEDED(texture->LockRect(0,&locked,nullptr,0))){HRESULT copied=converter->CopyPixels(nullptr,locked.Pitch,locked.Pitch*height,static_cast<BYTE*>(locked.pBits));texture->UnlockRect(0);if(FAILED(copied)){texture->Release();texture=nullptr;}}
+        else{texture->Release();texture=nullptr;}
+      }
+      if(converter){converter->Release();converter=nullptr;}if(frame){frame->Release();frame=nullptr;}
+      if(texture)logoFrames.push_back(texture);
+     }
+     if(!logoFrames.empty())logo=logoFrames.front();
+ }
+ if(converter)converter->Release();if(frame)frame->Release();if(decoder)decoder->Release();if(factory)factory->Release();
+ if(SUCCEEDED(initialized))CoUninitialize();
+}
+}
+void RfdReleaseMenuDeviceState(){if(menuState){menuState->Release();menuState=nullptr;}}
+
+void RfdDrawProjectLogo(LPDIRECT3DDEVICE9 dev,const RECT &menuRect){
+ if(VideoWindowExists||(gbRunGame&&!LoadingScreenCEL))return;
+ if(owner!=dev){RfdReleaseMenuDeviceState();for(auto texture:logoFrames)texture->Release();logoFrames.clear();logo=nullptr;if(footer){footer->Release();footer=nullptr;}owner=dev;attempted=false;}
+ if(!footer&&!gbRunGame){std::vector<unsigned char> pixels(512*24);if(RfdMenuFooter(pixels.data(),512,24)&&SUCCEEDED(dev->CreateTexture(512,24,1,0,D3DFMT_A8R8G8B8,D3DPOOL_MANAGED,&footer,nullptr))){D3DLOCKED_RECT locked;if(SUCCEEDED(footer->LockRect(0,&locked,nullptr,0))){for(int y=0;y<24;y++)for(int x=0;x<512;x++){unsigned char value=pixels[y*512+x];auto &color=MenuPalette[value];unsigned int intensity=std::max(60u,(unsigned(color.peRed)+color.peGreen+color.peBlue)/3);((DWORD*)((char*)locked.pBits+y*locked.Pitch))[x]=value?0xc0000000|(intensity<<16)|(intensity<<8)|intensity:0;}footer->UnlockRect(0);}}}
+ if(MainMainMenu||LoadingScreenCEL){if(!attempted){attempted=true;loadLogo(dev);}if(logo)logo=logoFrames[(GetTickCount()/80)%logoFrames.size()];}
+ if(!menuState&&FAILED(dev->CreateStateBlock(D3DSBT_ALL,&menuState)))return;IDirect3DStateBlock9 *state=menuState;
+ state->Capture();
+ const float sx=float(menuRect.right-menuRect.left+1)/640.0f;
+ const float sy=float(menuRect.bottom-menuRect.top+1)/480.0f;
+ const float h=140.0f*sy,w=h*(768.0f/280.0f);
+ const float x=(menuRect.left+menuRect.right+1-w)*0.5f-0.5f,y=menuRect.top+4.0f*sy-0.5f;
+ struct Vertex{float x,y,z,rhw;DWORD color;float u,v;};
+ Vertex quad[]={{x,y,0,1,0xffffffff,0,0},{x+w,y,0,1,0xffffffff,1,0},{x,y+h,0,1,0xffffffff,0,1},{x+w,y+h,0,1,0xffffffff,1,1}};
+ dev->SetPixelShader(nullptr);dev->SetVertexShader(nullptr);dev->SetTexture(0,logo);dev->SetTexture(1,nullptr);
+ dev->SetRenderState(D3DRS_ALPHABLENDENABLE,TRUE);dev->SetRenderState(D3DRS_SRCBLEND,D3DBLEND_SRCALPHA);dev->SetRenderState(D3DRS_DESTBLEND,D3DBLEND_INVSRCALPHA);
+ dev->SetRenderState(D3DRS_ZENABLE,FALSE);dev->SetRenderState(D3DRS_CULLMODE,D3DCULL_NONE);
+ dev->SetTextureStageState(0,D3DTSS_COLOROP,D3DTOP_MODULATE);dev->SetTextureStageState(0,D3DTSS_COLORARG1,D3DTA_TEXTURE);dev->SetTextureStageState(0,D3DTSS_COLORARG2,D3DTA_DIFFUSE);
+ dev->SetTextureStageState(0,D3DTSS_ALPHAOP,D3DTOP_SELECTARG1);dev->SetTextureStageState(0,D3DTSS_ALPHAARG1,D3DTA_TEXTURE);
+ dev->SetTextureStageState(1,D3DTSS_COLOROP,D3DTOP_DISABLE);
+ dev->SetSamplerState(0,D3DSAMP_MINFILTER,D3DTEXF_LINEAR);dev->SetSamplerState(0,D3DSAMP_MAGFILTER,D3DTEXF_LINEAR);
+ dev->SetFVF(D3DFVF_XYZRHW|D3DFVF_DIFFUSE|D3DFVF_TEX1);
+ if(logo&&(MainMainMenu||LoadingScreenCEL))dev->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP,2,quad,sizeof(Vertex));
+ if(footer&&!gbRunGame){D3DVIEWPORT9 viewport;dev->GetViewport(&viewport);const float left=20.f,bottom=float(viewport.Height)-18.f,top=bottom-24.f;Vertex line[]={{left,top,0,1,0xffffffff,0,0},{left+512,top,0,1,0xffffffff,1,0},{left,bottom,0,1,0xffffffff,0,1},{left+512,bottom,0,1,0xffffffff,1,1}};dev->SetTexture(0,footer);dev->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP,2,line,sizeof(Vertex));}
+ state->Apply();
+}
