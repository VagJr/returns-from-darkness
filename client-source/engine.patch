+BOOL CALLBACK repaintMenuWindow(HWND window,LPARAM force){
+ if(window==ghMainWnd||!IsWindowVisible(window)||GetWindowThreadProcessId(window,nullptr)!=GetCurrentThreadId())return TRUE;
+ RECT bounds{};GetWindowRect(window,&bounds);DWORD now=GetTickCount();
+ auto repair=std::find_if(menuRepairs.begin(),menuRepairs.end(),[&](const MenuRepair &value){return value.window==window;});
+ bool changed=repair==menuRepairs.end()||memcmp(&repair->bounds,&bounds,sizeof(bounds))!=0;
+ if(repair==menuRepairs.end()){menuRepairs.push_back({window,bounds,now+200,true});repair=menuRepairs.end()-1;}
+ else if(changed||force){repair->bounds=bounds;repair->settleAt=now+200;repair->settlePending=true;}
+ bool settle=!changed&&!force&&repair->settlePending&&LONG(now-repair->settleAt)>=0;
+ if(!force&&!changed&&!settle)return TRUE;
+ if(settle)repair->settlePending=false;
+ #if RFD_DEV_QA
+ double start=menuPerfClock();
+ #endif
+ RedrawWindow(window,nullptr,nullptr,RDW_INVALIDATE|RDW_ERASE|RDW_ALLCHILDREN|RDW_UPDATENOW);
+ #if RFD_DEV_QA
+ double elapsed=menuPerfClock()-start;++menuRepaintPerf.repairs;menuRepaintPerf.elapsedMs+=elapsed;menuRepaintPerf.maxMs=std::max(menuRepaintPerf.maxMs,elapsed);
+ #endif
+ return TRUE;
+}
+bool repaintingMenus=false;
+void pollMenuRepairs(){
+ if(repaintingMenus||gbRunGame||VideoWindowExists||!ghMainWnd||IsMainWindowMinimized)return;
+ repaintingMenus=true;
+ menuRepairs.erase(std::remove_if(menuRepairs.begin(),menuRepairs.end(),[](const MenuRepair &value){return !IsWindow(value.window)||!IsWindowVisible(value.window);}),menuRepairs.end());
+ #if RFD_DEV_QA
+ ++menuRepaintPerf.polls;EnumThreadWindows(GetCurrentThreadId(),repaintMenuWindow,legacyMenuRepaintQa()?1:0);
+ #else
+ EnumThreadWindows(GetCurrentThreadId(),repaintMenuWindow,0);
+ #endif
+ repaintingMenus=false;
+}
+}
+
+#if RFD_DEV_QA
+void RfdRecordMenuPresent(){
+ char enabled[16]={};GetEnvironmentVariableA("RFD_MENU_PERF_QA",enabled,sizeof(enabled));if(!enabled[0]||gbRunGame||VideoWindowExists)return;
+ double now=menuPerfClock();if(menuRepaintPerf.lastPresent&&menuRepaintPerf.gaps.size()<50000)menuRepaintPerf.gaps.push_back(now-menuRepaintPerf.lastPresent);
+ menuRepaintPerf.lastPresent=now;++menuRepaintPerf.presents;
+}
+#endif
+// Storm owns top-level popup dialogs, rather than child windows of ghMainWnd.
+// Repaint from the UI queue, independently of mouse input and D3D presentation.
+// Never synchronously dispatch WM_PAINT from the renderer: that re-enters Storm.
+void RfdRepaintMenus(){
+    if(repaintingMenus||gbRunGame||VideoWindowExists||!ghMainWnd||IsMainWindowMinimized)return;
+    repaintingMenus=true;
+	EnumThreadWindows(GetCurrentThreadId(),repaintMenuWindow,1);
+    repaintingMenus=false;
+}
 
