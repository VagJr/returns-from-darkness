+}
+bool coordinates(void *destination,int &x,int &y){
+ const auto value=reinterpret_cast<uintptr_t>(destination),base=reinterpret_cast<uintptr_t>(WorkingSurface);
+ if(!WorkingSurface||value<base||value>=base+size_t(WorkingWidth)*WorkingHeight)return false;
+ const size_t offset=value-base;x=int(offset%WorkingWidth)-Screen_LeftBorder;y=int(offset/WorkingWidth)-Screen_TopBorder;
+ return y>=0&&y<ScreenHeight;
+}
+}
+void RfdHdBeginWorld(){
+ const size_t size=size_t(ScreenWidth)*ScreenHeight;plane.assign(size,0);collecting=true;floorDraw=false;originKnown=false;
+}
+void RfdHdEndWorld(){collecting=false;floorDraw=false;}
+void RfdHdFloor(int row,int col,int x,int y,bool enabled){
+ floorDraw=enabled;if(!enabled||originKnown)return;
+ const float sx=float(x-Screen_LeftBorder),sy=float(y-Screen_TopBorder);
+ originU=row-sx/64.0f-sy/32.0f;originV=col+sx/64.0f-sy/32.0f;originKnown=true;
+}
+void RfdHdSpan(void *destination,int length,unsigned int bits){
+ if(!collecting||plane.empty()||length<=0)return;int x,y;if(!coordinates(destination,x,y))return;
+ const auto source=static_cast<unsigned char*>(destination);
+ for(int i=0;i<length;i++,bits<<=1){if(!(bits&0x80000000)||x+i<0||x+i>=ScreenWidth)continue;
+  DWORD value=0;const unsigned index=source[i];
+  if(floorDraw&&index){const auto &color=ScreenPalette[index];
+   const bool grass=color.peGreen>color.peRed*1.04f&&color.peGreen>color.peBlue*1.02f;
+   const bool town=Dungeon->genType==DT_0_TOWN&&!Dungeon->isQuest;
+   const bool cathedral=Dungeon->graphType==DT_1_CHURCH;
+   if((town&&!grass)||cathedral)value=0xff000000u|0x00ff0000u|(index<<8);
+  }
+  plane[size_t(y)*ScreenWidth+x+i]=value;
+ }
+}
+void RfdHdClearSprite(void *destination,int width,int height){
+ if(!gbRunGame||plane.empty()||width<=0||height<=0)return;int x,y;if(!coordinates(destination,x,y))return;
+ const int left=std::max(0,x-2),right=std::min(ScreenWidth,x+width+2),top=std::max(0,y-height-2),bottom=std::min(ScreenHeight,y+3);
+ for(int j=top;j<bottom;j++)if(right>left)std::fill(plane.begin()+size_t(j)*ScreenWidth+left,plane.begin()+size_t(j)*ScreenWidth+right,0u);
+}
+void RfdHdClearPixel(void *destination){
+ if(!gbRunGame||plane.empty())return;int x,y;if(coordinates(destination,x,y)&&x>=0&&x<ScreenWidth)plane[size_t(y)*ScreenWidth+x]=0;
+}
+void RfdHdZoom(){
+ if(plane.empty())return;
+ for(int y=ScreenHeight/2-1;y>=0;y--)for(int x=ScreenWidth/2-1;x>=0;x--){DWORD value=plane[size_t(y)*ScreenWidth+x];const size_t dst=size_t(y*2)*ScreenWidth+x*2;plane[dst]=plane[dst+1]=plane[dst+ScreenWidth]=plane[dst+ScreenWidth+1]=value;}
+}
+bool RfdHdBind(LPDIRECT3DDEVICE9 device,unsigned char *frame,int pitch){
