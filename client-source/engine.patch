+			}
+			if (fullClassId == PFC_WARRIOR && itemCode == IC_3_BOW && baseItem.AnimationDelay == 0 && (!(HasTrait(CurrentPlayerIndex, TraitId::Ranger)))) { // bow for warrior-non-ranger
