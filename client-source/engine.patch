+				//	player.CurrentSpellNumber = PS_M1_NONE;
+				//	player.SpellType = SO_4_DISABLE;
+				//}
+				return 0;
+			};
+
+			// Отлавливаем клавиши [A]-[Z], [F1]-[F8], [CTRL]
