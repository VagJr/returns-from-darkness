+			if( playerIndex == CurrentPlayerIndex ){
+				DeathDelayTimer--;
+				if( DeathDelayTimer == 1 ){
+					IsPlayerDead = 1;
+					#if th2_crucifixion
+					if( NetPlayerCount == 1 ){
