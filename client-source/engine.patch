+void UpdateItem( Item& item, bool keepCharges /*= true*/)
+{
+	LastItemInfo info;
+	SaveItem( &info, &item );
+	LoadItem( &info, &item, keepCharges );
+	item.IsReqMet = CheckItemReq(CurrentPlayerIndex, &item);
+}
