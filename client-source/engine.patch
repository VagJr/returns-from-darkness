+int GetNumberOfObjectsInDungeon() {
+	int activeObjects = 0;
+	if( Dungeon == DUN_0_TOWN ){
+		return 0;
+	}
+	for (int objIndex = 0; objIndex < ObjectsCount; objIndex++) {
+		Object& obj = Objects[ObjectActive[objIndex]];
+		if (IsIronmanObject(obj)) {
+			++activeObjects;
+		}
+	}
+	return activeObjects;
+}
