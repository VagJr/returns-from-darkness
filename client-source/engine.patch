+//----- (0044607C) --------------------------------------------------------
+void MegaAddPacket()
+{
+	// TODO: check original
+	sgpCurrPkt = (TMegaPkt*)AllocMem( sizeof(TMegaPkt) );
+	sgpCurrPkt->pNext = nullptr;
+	sgpCurrPkt->dwSpaceLeft = sizeof(sgpCurrPkt->data);
+	
+	auto it = (TMegaPkt *)&sgpMegaPkt;
+	while( it->pNext ) {
+		it = it->pNext;
+	}
+	it->pNext = sgpCurrPkt;
+}
