+typedef uchar uchara[];
+
+/* helper to write a little-endian 16-bit number portably */
+#define write_num(fd, n) write((fd), uchara {uchar((n) & 0xFF), uchar((n) >> 8)} , 2)
+
+static uchar vga[0x30] = {
+    0x00, 0x00, 0x00,
+    0xAA, 0x00, 0x00,
+    0x00, 0xAA, 0x00,
+    0xAA, 0x55, 0x00,
