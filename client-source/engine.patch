+void closeMenuIdleTimer(){if(menuIdleTimer){CancelWaitableTimer(menuIdleTimer);CloseHandle(menuIdleTimer);menuIdleTimer=nullptr;}}
+void waitMenuInput(){
+ if(!menuIdleTimerAttempted){
+  menuIdleTimerAttempted=true;
+  using CreateTimerProc=HANDLE (WINAPI *)(LPSECURITY_ATTRIBUTES,LPCWSTR,DWORD,DWORD);
+  auto createTimer=reinterpret_cast<CreateTimerProc>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"),"CreateWaitableTimerExW"));
