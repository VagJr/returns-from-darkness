+	if( frameSize2 ){
+		frameDataSize = frameSize2 - frameDataStart;
+	}else{
+		frameDataSize = frameSize - frameDataStart;
+	}
+	RleDraw((uchar*)dst, framePtr + frameDataStart, frameDataSize, width);
