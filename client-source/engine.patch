+		// 0043E596
+#ifdef comment
+		if( player.affixFlag & AF_27_BONUS_DAMAGE_VS_UNDEAD ){ // старый бит шипов. в 1.145 отключено
+			int affixReflectDamage = (RNG(100) + 1) << 6;
