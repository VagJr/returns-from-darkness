+		case DL_5_AGONY:		xp = 16'000'000;	break;
+		case DL_6_TERROR:		xp = 32'000'000;	break;
+		case DL_7_DESTRUCTION:	xp = 64'000'000;	break;
+		case DL_8_INFERNO:		xp = 128'000'000;	break;
+	}
+	AddPlayerExperience(CurrentPlayerIndex, xp);
