-		if( item.bCmd != ITEM_FREE && item.info == packet->info ){
-			if( item.bCmd != ITEM_GEN_TAKEN ){
-				if( item.bCmd != ITEM_GEN_FLOOR ){
-					if( item.bCmd != ITEM_DROP_FLOOR ){
