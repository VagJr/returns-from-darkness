+void operator += ( PlayerStat& stat, int value )
+{
+    stat.Strength  += value;
+    stat.Magic     += value;
+    stat.Dexterity += value;
+    stat.Vitality  += value;
+}
+
+void operator -= ( PlayerStat& stat, int value )
+{
+    stat.Strength  -= value;
+    stat.Magic     -= value;
+    stat.Dexterity -= value;
+    stat.Vitality  -= value;
+}
