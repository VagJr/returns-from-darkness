+// RFD reliquary vessels: continuous, output-resolution glass and liquid.
+// No low-resolution sprite enlargement or inherited panel fill offsets.
+sampler2D visibility : register(s0);
+sampler2D animation : register(s1);
+float4 vessel : register(c0); // actual resource ratio, seconds, mana flag, edge width
+float4 animationInfo : register(c1); // loaded, 48 frames at 24 Hz
+float4 silhouette : register(c2); // original 256x256 glass center and radius
+float4 maskInfo : register(c3); // mask UV extent, new kit uses its own frame
+float4 main_orb(float2 uv : TEXCOORD0) : COLOR0 {
+ float2 p=uv*2-1;
+ float radius=length(p), aa=vessel.w;
+ float outer=1-smoothstep(.985-aa,.985+aa,radius);
+ float inner=1-smoothstep(.84-aa,.84+aa,radius);
+ float ratio=saturate(vessel.x), t=vessel.y;
+ // Waves vanish at both endpoints: zero is empty, one reaches the entire rim.
+ float wave=sin(p.x*8+t*2.1)*.016+sin(p.x*17-t*1.3)*.009;
+ float surface=(1-2*ratio)*.84+wave*4*ratio*(1-ratio);
+ float wet=smoothstep(surface-aa,surface+aa,p.y);
+ wet=ratio>=.99999?1:(ratio<=.00001?0:wet);
+ float depth=sqrt(saturate(1-dot(p,p)/(.84*.84)));
+ float swirl=sin(p.x*13+p.y*9+t*.9)*sin(p.x*6-p.y*14-t*1.1);
+ float3 pigment=lerp(float3(.57,.018,.028),float3(.018,.17,.69),vessel.z);
+ float3 liquid=pigment*(.52+depth*.68+swirl*.10);
+ float frame=floor(fmod(t*24,48));
+ float2 tile=float2(fmod(frame,8),floor(frame/8));
+ // Use the original liquid only. The tight inner sample avoids the inherited
+ // panel's statues, horizontal rule and outer silver hoop in each source frame.
+ float2 atlasUV=(tile*256+silhouette.xy+p/.84*46)/float2(2048,1536);
+ float3 prepared=tex2D(animation,atlasUV).rgb;
+ float neutral=1-saturate((max(prepared.r,max(prepared.g,prepared.b))-min(prepared.r,min(prepared.g,prepared.b)))*6);
+ float oldRim=smoothstep(.40,.68,p.y)*neutral;
+ liquid=lerp(liquid,lerp(prepared,pigment*(.52+depth*.68),oldRim),animationInfo.x);
+ float meniscus=exp(-abs(p.y-surface)*120)*4*ratio*(1-ratio);
+ liquid+=lerp(float3(.55,.09,.035),float3(.07,.29,.58),vessel.z)*meniscus;
+ float3 empty=float3(.018,.022,.024)+float3(.018,.018,.016)*depth;
+ float3 glass=lerp(empty,liquid,wet);
+ float spec=exp(-((p.x+.33)*(p.x+.33)*55+(p.y+.40)*(p.y+.40)*150));
+ float rimLight=pow(saturate(1-abs(radius-.79)/.036),3)*saturate(-p.y*.9-p.x*.5);
+ glass+=float3(.65,.71,.72)*spec*.43+float3(.32,.37,.38)*rimLight*.25;
