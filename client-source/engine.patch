+void LoadFlipItemCELFiles()
+{
+	unsigned int FileCount; // esi@1
+	char FileName[64];      // [sp+4h] [bp-40h]@2
+	FileCount = 0;
+	do{
+		sprintf( FileName, "Items\\%s.CEL", Flip_FileName[ FileCount ] );
+		FlipItemCELFiles[ FileCount ] = (char*) LoadFile( FileName, NULL );
