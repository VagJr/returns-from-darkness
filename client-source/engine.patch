+	AddLight( Monsters[ v3 ].Row, Monsters[ v3 ].Col, 8 );
+	DoVision( Monsters[ v3 ].Row, Monsters[ v3 ].Col, 8, 0, 1 );
+	v6 = abs( PlayerColPos - Monsters[ v3 ].Col );
